---
// Schematic visual representation of the AI Engineer Command Center workspace
---

<div class="ps-card-visual" aria-hidden="true">
  <svg
    viewBox="0 0 640 220"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="ps-visual-svg"
    role="img"
    aria-label="Schematic diagram of AI Engineer Command Center learning workspace"
  >
    <!-- Background surface -->
    <rect width="640" height="220" fill="#FDFCF8" stroke="#17191A" stroke-width="1" />

    <!-- Top telemetry header -->
    <rect x="0" y="0" width="640" height="26" fill="#EFEBDF" stroke="#17191A" stroke-width="1" />
    <circle cx="16" cy="13" r="4" fill="#D3F03C" stroke="#17191A" stroke-width="1" />
    <text x="28" y="17" font-family="'Cascadia Code', Consolas, monospace" font-size="9.5" font-weight="700" fill="#17191A" letter-spacing="0.08em">WORKSPACE // 20-WEEK CURRICULUM TRACKER & ANALYTICS</text>
    <text x="560" y="17" font-family="'Cascadia Code', Consolas, monospace" font-size="9" font-weight="600" fill="#4A4F4C">PRJ-004 · LIVE</text>

    <!-- Module 1: 20-Week Grid Tracker -->
    <g transform="translate(18, 42)">
      <rect width="180" height="160" fill="#F7F4EC" stroke="#17191A" stroke-width="1" />
      <rect width="180" height="20" fill="#17191A" />
      <text x="10" y="14" font-family="'Cascadia Code', Consolas, monospace" font-size="8.5" font-weight="700" fill="#FDFCF8" letter-spacing="0.06em">20-WEEK PROGRESSION</text>

      <!-- 4x5 Weeks Grid Matrix -->
      <!-- Row 1 -->
      <rect x="12" y="30" width="34" height="20" fill="#D3F03C" stroke="#17191A" stroke-width="0.8" />
      <text x="19" y="43" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="700" fill="#17191A">W01</text>
      <rect x="52" y="30" width="34" height="20" fill="#D3F03C" stroke="#17191A" stroke-width="0.8" />
      <text x="59" y="43" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="700" fill="#17191A">W02</text>
      <rect x="92" y="30" width="34" height="20" fill="#D3F03C" stroke="#17191A" stroke-width="0.8" />
      <text x="99" y="43" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="700" fill="#17191A">W03</text>
      <rect x="132" y="30" width="34" height="20" fill="#D3F03C" stroke="#17191A" stroke-width="0.8" />
      <text x="139" y="43" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="700" fill="#17191A">W04</text>

      <!-- Row 2 -->
      <rect x="12" y="55" width="34" height="20" fill="#F4D9C6" stroke="#17191A" stroke-width="0.8" />
      <text x="19" y="68" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="600" fill="#17191A">W05</text>
      <rect x="52" y="55" width="34" height="20" fill="#F4D9C6" stroke="#17191A" stroke-width="0.8" />
      <text x="59" y="68" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="600" fill="#17191A">W06</text>
      <rect x="92" y="55" width="34" height="20" fill="#F4D9C6" stroke="#17191A" stroke-width="0.8" />
      <text x="99" y="68" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="600" fill="#17191A">W07</text>
      <rect x="132" y="55" width="34" height="20" fill="#F4D9C6" stroke="#17191A" stroke-width="0.8" />
      <text x="139" y="68" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="600" fill="#17191A">W08</text>

      <!-- Row 3 -->
      <rect x="12" y="80" width="34" height="20" fill="#FDFCF8" stroke="#17191A" stroke-width="0.8" />
      <text x="19" y="93" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="500" fill="#4A4F4C">W09</text>
      <rect x="52" y="80" width="34" height="20" fill="#FDFCF8" stroke="#17191A" stroke-width="0.8" />
      <text x="59" y="93" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="500" fill="#4A4F4C">W10</text>
      <rect x="92" y="80" width="34" height="20" fill="#FDFCF8" stroke="#17191A" stroke-width="0.8" />
      <text x="99" y="93" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="500" fill="#4A4F4C">W11</text>
      <rect x="132" y="80" width="34" height="20" fill="#FDFCF8" stroke="#17191A" stroke-width="0.8" />
      <text x="139" y="93" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="500" fill="#4A4F4C">W12</text>

      <!-- Row 4-5 summary -->
      <line x1="12" y1="112" x2="166" y2="112" stroke="#827D71" stroke-dasharray="2 2" />
      <text x="12" y="128" font-family="'Cascadia Code', Consolas, monospace" font-size="8" fill="#4A4F4C">W13 – W20 : ADVANCED & CAPSTONE</text>
      <rect x="12" y="136" width="154" height="12" fill="#EFEBDF" stroke="#827D71" stroke-width="0.6" />
      <rect x="12" y="136" width="62" height="12" fill="#D3F03C" stroke="#17191A" stroke-width="0.6" />
    </g>

    <!-- Module 2: Flashcards & Active Revision -->
    <g transform="translate(214, 42)">
      <rect width="200" height="74" fill="#FDFCF8" stroke="#17191A" stroke-width="1" />
      <rect width="200" height="20" fill="#EFEBDF" stroke="#17191A" stroke-width="0.8" />
      <text x="10" y="14" font-family="'Cascadia Code', Consolas, monospace" font-size="8.5" font-weight="700" fill="#17191A" letter-spacing="0.06em">FLASHCARDS // SPACED REVISION</text>

      <!-- Card mock -->
      <rect x="12" y="28" width="176" height="38" fill="#F7F4EC" stroke="#17191A" stroke-width="0.8" rx="2" />
      <line x1="22" y1="38" x2="140" y2="38" stroke="#17191A" stroke-width="1.5" />
      <line x1="22" y1="46" x2="110" y2="46" stroke="#827D71" stroke-width="1" />
      <circle cx="166" cy="47" r="10" fill="#D3F03C" stroke="#17191A" stroke-width="0.8" />
      <text x="160" y="50" font-family="'Cascadia Code', Consolas, monospace" font-size="8" font-weight="700" fill="#17191A">4/5</text>
    </g>

    <!-- Module 3: Study Log & Journal -->
    <g transform="translate(214, 126)">
      <rect width="200" height="76" fill="#FDFCF8" stroke="#17191A" stroke-width="1" />
      <rect width="200" height="20" fill="#EFEBDF" stroke="#17191A" stroke-width="0.8" />
      <text x="10" y="14" font-family="'Cascadia Code', Consolas, monospace" font-size="8.5" font-weight="700" fill="#17191A" letter-spacing="0.06em">STUDY SESSION LOG & JOURNAL</text>

      <!-- Terminal prompt lines -->
      <text x="12" y="36" font-family="'Cascadia Code', Consolas, monospace" font-size="7.5" fill="#4A4F4C">> log --topic "Transformer Attention"</text>
      <text x="12" y="49" font-family="'Cascadia Code', Consolas, monospace" font-size="7.5" fill="#4A4F4C">> recorded: 2h 45m · 12 flashcards</text>
      <text x="12" y="62" font-family="'Cascadia Code', Consolas, monospace" font-size="7.5" fill="#17191A" font-weight="700">> status: active tracking synchronized</text>
    </g>

    <!-- Module 4: Analytics Sparkline Panel -->
    <g transform="translate(430, 42)">
      <rect width="192" height="160" fill="#F7F4EC" stroke="#17191A" stroke-width="1" />
      <rect width="192" height="20" fill="#17191A" />
      <text x="10" y="14" font-family="'Cascadia Code', Consolas, monospace" font-size="8.5" font-weight="700" fill="#FDFCF8" letter-spacing="0.06em">LEARNING ANALYTICS</text>

      <!-- Metric tiles -->
      <rect x="12" y="28" width="78" height="34" fill="#FDFCF8" stroke="#17191A" stroke-width="0.8" />
      <text x="18" y="40" font-family="'Cascadia Code', Consolas, monospace" font-size="7" fill="#4A4F4C">CURRICULUM</text>
      <text x="18" y="55" font-family="'Cascadia Code', Consolas, monospace" font-size="12" font-weight="700" fill="#17191A">20 WEEKS</text>

      <rect x="102" y="28" width="78" height="34" fill="#FDFCF8" stroke="#17191A" stroke-width="0.8" />
      <text x="108" y="40" font-family="'Cascadia Code', Consolas, monospace" font-size="7" fill="#4A4F4C">STATUS</text>
      <text x="108" y="55" font-family="'Cascadia Code', Consolas, monospace" font-size="11" font-weight="700" fill="#17191A">PUBLISHED</text>

      <!-- Sparkline chart -->
      <rect x="12" y="70" width="168" height="66" fill="#FDFCF8" stroke="#17191A" stroke-width="0.8" />
      <line x1="12" y1="92" x2="180" y2="92" stroke="#EFEBDF" stroke-width="1" />
      <line x1="12" y1="114" x2="180" y2="114" stroke="#EFEBDF" stroke-width="1" />

      <!-- Line path -->
      <path d="M 20 126 L 45 118 L 75 110 L 105 95 L 135 88 L 165 78" stroke="#17191A" stroke-width="2" stroke-linecap="round" fill="none" />
      <circle cx="165" cy="78" r="4" fill="#D3F03C" stroke="#17191A" stroke-width="1.2" />

      <!-- Tech tags footer -->
      <text x="12" y="150" font-family="'Cascadia Code', Consolas, monospace" font-size="7" fill="#4A4F4C">STACK: REACT · TS · VITE · TAILWIND</text>
    </g>
  </svg>
</div>

<style>
  .ps-visual-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 640 / 220;
  }
</style>
