---
import { normalizeProvenanceLabel, formatProjectStatus, type ProvenanceLabel } from '../lib/projectCompatibility';
import CommandCenterVisual from './visuals/CommandCenterVisual.astro';
import RagPipelineVisual from './visuals/RagPipelineVisual.astro';

export interface ProjectCardData {
  _id?: string;
  workbookId?: string;
  title: string;
  slug: string | { current: string };
  summary?: string;
  problem?: string;
  provenance?: string;
  status?: string;
  techStack?: string[];
  links?: {
    repo?: string | null;
    demo?: string | null;
    live?: string | null;
  } | null;
  metric?: string | null;
  featured?: boolean;
  category?: string;
  role?: string;
  endDate?: string | null;
  completedDate?: string | null;
}

export interface Props {
  project?: ProjectCardData;
  title?: string;
  slug?: string | { current: string };
  summary?: string;
  problem?: string;
  provenance?: string;
  status?: string;
  techStack?: string[];
  links?: {
    repo?: string | null;
    demo?: string | null;
    live?: string | null;
  } | null;
  githubUrl?: string | null;
  demoUrl?: string | null;
  metric?: string | null;
  role?: string;
  index?: number;
  featured?: boolean;
  headingLevel?: 2 | 3;
  class?: string;
}

const {
  project,
  title: propTitle,
  slug: propSlug,
  summary: propSummary,
  problem: propProblem,
  provenance: propProvenance,
  status: propStatus,
  techStack: propTechStack,
  links: propLinks,
  githubUrl: propGithubUrl,
  demoUrl: propDemoUrl,
  metric: propMetric,
  role: propRole,
  index: propIndex,
  headingLevel = 3,
  class: className = '',
} = Astro.props;

// Reconcile direct props vs project document fields
const rawTitle = propTitle || project?.title || '';
const title = typeof rawTitle === 'string' ? rawTitle.trim() : '';

const rawSlug = propSlug || project?.slug || '';
const slugString = typeof rawSlug === 'string' ? rawSlug.trim() : rawSlug?.current?.trim() || '';
const caseStudyHref = slugString ? `/projects/${slugString}/` : undefined;

const rawProblem = propProblem || propSummary || project?.problem || project?.summary || '';
const problemStatement = typeof rawProblem === 'string' ? rawProblem.trim() : '';

// Provenance: strictly validate against the 4 approved schema values
const rawProvenance = propProvenance || project?.provenance;
const provenanceLabel: ProvenanceLabel | undefined = normalizeProvenanceLabel(rawProvenance);

// Status: normalize and resolve human-readable display label
const rawStatus = propStatus || project?.status;
const baseStatusLabel = formatProjectStatus(rawStatus);
const statusLabel = formatProjectStatus(rawStatus, {
  _id: project?._id,
  workbookId: project?.workbookId,
  slug: slugString,
}) ?? baseStatusLabel;
const normalizedStatus = statusLabel
  ? statusLabel.trim().toLowerCase().replace(/\s+/g, '-')
  : undefined;

// Stack tags: filter empty / non-string elements
const rawStack = propTechStack || project?.techStack;
const stackTags = Array.isArray(rawStack)
  ? rawStack.filter((t): t is string => typeof t === 'string' && t.trim().length > 0).map((t) => t.trim())
  : [];

// External links: omit when absent, empty, or undefined; never render dead links
const rawGithub = propGithubUrl || propLinks?.repo || project?.links?.repo;
const githubUrl = typeof rawGithub === 'string' && rawGithub.trim().length > 0 ? rawGithub.trim() : undefined;

const rawDemo = propDemoUrl || propLinks?.demo || propLinks?.live || project?.links?.demo || project?.links?.live;
const demoUrl = typeof rawDemo === 'string' && rawDemo.trim().length > 0 ? rawDemo.trim() : undefined;

// Optional metric line
const rawMetric = propMetric || project?.metric;
const metricText = typeof rawMetric === 'string' && rawMetric.trim().length > 0 ? rawMetric.trim() : undefined;

// Role / Contribution
const rawRole = propRole || project?.role;
const role = typeof rawRole === 'string' && rawRole.trim().length > 0 ? rawRole.trim() : undefined;

// Identifiers
const workbookId = project?.workbookId;
const markNumber = typeof propIndex === 'number' ? String(propIndex + 1).padStart(2, '0') : undefined;
---

<article
  class:list={[
    'ps-project-card',
    'ps-card-editorial',
    'ps-card-project',
    'ps-playbook-card',
    { 'ps-card-project--rag': slugString === 'grounded-technical-docs-rag-assistant' },
    { 'ps-card-project--command-center': slugString === 'ai-engineer-command-center' },
    className,
  ]}
  data-project-card
  data-project-slug={slugString}
>
  <div class="ps-card-top">
    {markNumber ? (
      <span class="ps-card-mark" aria-hidden="true">
        {markNumber}
      </span>
    ) : (
      <div class="ps-card-top-spacer" aria-hidden="true" />
    )}
    <div class="ps-card-badges">
      {workbookId && (
        <span class="ps-card-badge ps-card-badge--playbook">
          Playbook · {workbookId}
        </span>
      )}
      {provenanceLabel && (
        <span class="ps-card-badge ps-card-badge--provenance" data-provenance={provenanceLabel}>
          {provenanceLabel}
        </span>
      )}
      {statusLabel && (
        <span class="ps-card-badge ps-card-badge--status" data-status={normalizedStatus}>
          {statusLabel}
        </span>
      )}
    </div>
  </div>

  {slugString === 'ai-engineer-command-center' && (
    <CommandCenterVisual />
  )}
  {slugString === 'grounded-technical-docs-rag-assistant' && (
    <RagPipelineVisual />
  )}

  <div class="ps-card-content-wrap">
    {workbookId ? (
      <p class="ps-kicker">Project · {workbookId}</p>
    ) : (
      <p class="ps-kicker">Project · Case study</p>
    )}

    {headingLevel === 2 ? (
      <h2 class="ps-card-title">
        {caseStudyHref ? (
          <a
            href={caseStudyHref}
            class="ps-card-title-link"
            aria-label={`Read case study: ${title}`}
          >
            {title}
          </a>
        ) : (
          <span>{title}</span>
        )}
      </h2>
    ) : (
      <h3 class="ps-card-title">
        {caseStudyHref ? (
          <a
            href={caseStudyHref}
            class="ps-card-title-link"
            aria-label={`Read case study: ${title}`}
          >
            {title}
          </a>
        ) : (
          <span>{title}</span>
        )}
      </h3>
    )}

    {problemStatement && (
      <div class="ps-card-problem-wrap">
        <p class="ps-card-problem ps-card-clamp" id={`desc-${slugString}`}>{problemStatement}</p>
        <button
          type="button"
          class="ps-card-expand-btn ps-desc-toggle"
          aria-expanded="false"
          aria-controls={`desc-${slugString}`}
          aria-label={`Toggle full description for ${title}`}
        >
          <span class="ps-expand-text">More</span>
          <span class="ps-expand-icon" aria-hidden="true">+</span>
        </button>
      </div>
    )}

    {role && (
      <div class="ps-playbook-dossier" aria-label={`Engineering contribution for ${title}`}>
        <div class="ps-dossier-header">
          <span class="ps-dossier-indicator" aria-hidden="true" />
          <span class="ps-dossier-label">Engineering Contribution</span>
        </div>
        <p class="ps-dossier-text">{role}</p>
      </div>
    )}

    {metricText && (
      <div class="ps-card-metric" aria-label="Project metric">
        <span class="ps-metric-label">Key Metric:</span>
        <span class="ps-metric-value">{metricText}</span>
      </div>
    )}

    {stackTags.length > 0 && (
      <div class="ps-card-stack-wrap">
        <ul class="ps-card-stack" id={`stack-${slugString}`} aria-label="Technologies used">
          {stackTags.map((tech, idx) => (
            <li class:list={['ps-card-stack-tag', { 'ps-tag--overflow': idx >= 4 }]}>{tech}</li>
          ))}
        </ul>
        {stackTags.length > 4 && (
          <button
            type="button"
            class="ps-card-expand-btn ps-tech-toggle"
            aria-expanded="false"
            aria-controls={`stack-${slugString}`}
            data-overflow-count={stackTags.length - 4}
            aria-label={`Toggle all technologies for ${title}`}
          >
            <span class="ps-expand-text">+{stackTags.length - 4} More</span>
          </button>
        )}
      </div>
    )}
  </div>

  <div class="ps-card-actions" aria-label={`Actions for ${title}`}>
    {githubUrl && (
      <a
        href={githubUrl}
        class="ps-card-action ps-card-action--github"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`GitHub repository for ${title}`}
      >
        <span>GitHub</span>
        <span class="ps-action-icon" aria-hidden="true">↗</span>
      </a>
    )}
    {demoUrl && (
      <a
        href={demoUrl}
        class="ps-card-action ps-card-action--demo"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Live demo for ${title}`}
      >
        <span>Live Demo</span>
        <span class="ps-action-icon" aria-hidden="true">↗</span>
      </a>
    )}
    {caseStudyHref && (
      <a
        href={caseStudyHref}
        class="ps-card-action ps-card-action--case-study"
        aria-label={`Explore case study for ${title}`}
      >
        <span>Explore Case Study</span>
        <span class="ps-action-icon" aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>
