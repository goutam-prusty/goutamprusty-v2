---
interface Props { href: string; variant?: 'primary' | 'secondary'; disabled?: boolean; }
const { href, variant = 'secondary', disabled = false } = Astro.props;
---

{disabled ? (
  <span class:list={['action', variant]} aria-disabled="true"><slot /></span>
) : (
  <a class:list={['action', variant]} href={href}><slot /></a>
)}

<style>
  .action { display: inline-flex; min-height: 2.9rem; align-items: center; justify-content: center; padding: 0.65rem 1rem; border: 1px solid var(--color-accent); border-radius: 0.25rem; font-size: 0.92rem; font-weight: 650; text-decoration: none; transition: background-color 120ms ease, color 120ms ease; }
  .primary { color: white; background: var(--color-accent); }
  .primary:hover { color: white; background: #285443; }
  .secondary { color: var(--color-accent); background: transparent; }
  .secondary:hover { background: var(--color-accent-soft); }
  @media (prefers-reduced-motion: reduce) { .action { transition: none; } }
</style>
