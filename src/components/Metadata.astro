---
interface Props { items: string[]; }
const { items } = Astro.props;
---

<ul class="metadata" aria-label="Item metadata">
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .metadata { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin: 0; padding: 0; color: var(--color-muted); font-size: 0.82rem; list-style: none; }
  .metadata li + li::before { content: '·'; margin-right: 1.1rem; color: var(--color-line); }
</style>
