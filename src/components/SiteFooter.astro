---
export interface SocialContactLinks {
  github?: string | null;
  linkedin?: string | null;
  medium?: string | null;
  email?: string | null;
  resume?: string | null;
}

export interface Props {
  socialLinks?: SocialContactLinks;
  aiDisclosure?: string | null;
  class?: string;
}

const {
  socialLinks = {},
  aiDisclosure = null,
  class: className = '',
} = Astro.props;

// Primary nav links per master plan sections 6.1 and 6.3
const primaryLinks = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Research', href: '/research/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

// Reconcile and strictly validate external links: only non-empty, non-whitespace strings
const rawGithub = socialLinks?.github;
const githubUrl = typeof rawGithub === 'string' && rawGithub.trim().length > 0
  ? rawGithub.trim()
  : undefined;

const rawLinkedin = socialLinks?.linkedin;
const linkedinUrl = typeof rawLinkedin === 'string' && rawLinkedin.trim().length > 0
  ? rawLinkedin.trim()
  : undefined;

const rawMedium = socialLinks?.medium;
const mediumUrl = typeof rawMedium === 'string' && rawMedium.trim().length > 0
  ? rawMedium.trim()
  : undefined;

const rawResume = socialLinks?.resume;
const resumeUrl = typeof rawResume === 'string' && rawResume.trim().length > 0
  ? rawResume.trim()
  : undefined;

const hasSocialLinks = Boolean(githubUrl || linkedinUrl || mediumUrl || resumeUrl);

// AI-Assistance disclosure: strictly owner-approved wording only
const disclosureText = typeof aiDisclosure === 'string' && aiDisclosure.trim().length > 0
  ? aiDisclosure.trim()
  : undefined;

const currentYear = new Date().getFullYear();
---

<footer class:list={['ps-footer', className]} aria-label="Site footer">
  <div class="ps-footer-grid">
    {/* 1. Identity & Wordmark */}
    <div class="ps-footer-col ps-footer-brand">
      <a class="ps-wordmark" href="/" aria-label="goutamprusty.com home">
        g<span>.</span>
      </a>
      <p class="ps-footer-brand-title">Goutam Prusty</p>
      <p class="ps-footer-tagline">
        A personal library of strategic intelligence, analytical writing, and practical systems.
      </p>
    </div>

    {/* 2. Primary Navigation */}
    <div class="ps-footer-col ps-footer-nav-col">
      <h2 class="ps-footer-heading">Navigation</h2>
      <ul class="ps-footer-list" aria-label="Footer navigation links">
        {primaryLinks.map((link) => (
          <li>
            <a href={link.href} class="ps-footer-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* 3. Connect / Social Links (Conditional: rendered only if verified links exist) */}
    {hasSocialLinks && (
      <div class="ps-footer-col ps-footer-social-col">
        <h2 class="ps-footer-heading">Connect</h2>
        <ul class="ps-footer-list" aria-label="Social and contact links">
          {githubUrl && (
            <li>
              <a
                href={githubUrl}
                class="ps-footer-link ps-footer-social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Goutam Prusty on GitHub (opens in new tab)"
              >
                <svg class="ps-footer-icon" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                </svg>
                <span>GitHub</span>
                <span class="ps-footer-ext" aria-hidden="true">↗</span>
              </a>
            </li>
          )}
          {linkedinUrl && (
            <li>
              <a
                href={linkedinUrl}
                class="ps-footer-link ps-footer-social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Goutam Prusty on LinkedIn (opens in new tab)"
              >
                <svg class="ps-footer-icon" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                  <path d="M13.6 0H2.4C1.08 0 0 1.08 0 2.4v11.2C0 14.92 1.08 16 2.4 16h11.2c1.32 0 2.4-1.08 2.4-2.4V2.4C16 1.08 14.92 0 13.6 0zM4.9 13.4H2.5V6h2.4v7.4zM3.7 4.95a1.38 1.38 0 1 1 0-2.76 1.38 1.38 0 0 1 0 2.76zm9.7 8.45H11V9.5c0-.93-.02-2.13-1.3-2.13-1.3 0-1.5 1.02-1.5 2.07v3.96H5.8V6h2.3v1.01h.03c.32-.61 1.1-1.25 2.27-1.25 2.43 0 2.88 1.6 2.88 3.68v3.96z" />
                </svg>
                <span>LinkedIn</span>
                <span class="ps-footer-ext" aria-hidden="true">↗</span>
              </a>
            </li>
          )}
          {mediumUrl && (
            <li>
              <a
                href={mediumUrl}
                class="ps-footer-link ps-footer-social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Goutam Prusty on Medium (opens in new tab)"
              >
                <svg class="ps-footer-icon" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                  <path d="M9.025 8c0 2.485-2.02 4.5-4.513 4.5A4.506 4.506 0 0 1 0 8c0-2.486 2.02-4.5 4.512-4.5A4.506 4.506 0 0 1 9.025 8m4.95 0c0 2.34-1.01 4.236-2.256 4.236S9.463 10.339 9.463 8c0-2.34 1.01-4.236 2.256-4.236S13.975 5.661 13.975 8M16 8c0 2.096-.355 3.795-.794 3.795-.438 0-.793-1.7-.793-3.795 0-2.096.355-3.795.794-3.795.438 0 .793 1.699.793 3.795" />
                </svg>
                <span>Medium</span>
                <span class="ps-footer-ext" aria-hidden="true">↗</span>
              </a>
            </li>
          )}
          {resumeUrl && (
            <li>
              <a
                href={resumeUrl}
                class="ps-footer-link ps-footer-social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View Resume (PDF opens in new tab)"
              >
                <span>Resume</span>
                <span class="ps-footer-ext" aria-hidden="true">(PDF) ↗</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    )}

    {/* 4. Back to top */}
    <div class="ps-footer-col ps-footer-top-col">
      <a href="#top" class="ps-footer-back-to-top" aria-label="Back to top of page">
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>

  {/* Footer bottom meta / copyright */}
  <div class="ps-footer-bottom">
    <p class="ps-footer-copy">
      © {currentYear} Goutam Prusty <span>·</span> goutamprusty.com
    </p>
    {disclosureText && (
      <p class="ps-footer-disclosure">{disclosureText}</p>
    )}
  </div>
</footer>
