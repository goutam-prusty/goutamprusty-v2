---
/**
 * Editorial Hero Portrait — Option C (Full-bleed, deliberate composition)
 * Paper & Signal × The Observatory — Visual Experience Upgrade
 *
 * - Full-bleed editorial photograph, no arch, no floating elements
 * - Rectangular frame with crosshair registration marks (four corners)
 * - Observatory compass reticle composited into the lower-left corner
 *   as an SVG overlay (mix-blend-mode: multiply)
 * - Coordinate badge above the frame
 * - Black caption strip below: name · role · location · OBS.01
 * - Clean vignette gradient to integrate photo with the cream paper background
 *
 * Automatically uses /images/portrait/goutam-prusty-editorial-restrained.webp
 * then .../goutam-prusty-editorial.webp then .../goutam-prusty.webp.
 * Falls back to a styled monogram placeholder if no photo is found.
 */
const proc = (globalThis as any).process;
const fsModule: any = proc?.getBuiltinModule ? proc.getBuiltinModule('fs') : null;
const pathModule: any = proc?.getBuiltinModule ? proc.getBuiltinModule('path') : null;

// Approved editorial portrait takes priority
const candidateFiles = [
  'goutam-prusty-editorial-restrained.webp',
  'goutam-prusty-editorial.webp',
  'goutam-prusty.webp',
  'goutam-prusty.png',
  'goutam-prusty.jpg',
  'goutam-prusty.jpeg',
];
let detectedPortraitPath: string | null = null;

if (fsModule && pathModule && proc?.cwd) {
  const portraitDir = pathModule.resolve(proc.cwd(), 'public/images/portrait');
  for (const file of candidateFiles) {
    if (fsModule.existsSync(pathModule.join(portraitDir, file))) {
      detectedPortraitPath = `/images/portrait/${file}`;
      break;
    }
  }
}
---

<div class="ps-editorial-portrait" role="region" aria-label="Editorial portrait composition">

  <!-- Observatory Coordinate Badge -->
  <div class="ps-portrait-obs-badge" aria-hidden="true">
    <span class="ps-portrait-obs-dot"></span>
    <span>OBS // 12.9716° N · 77.5946° E</span>
    <span style="color: var(--color-ink); font-weight: 700; padding-left: 0.2rem;">BENGALURU</span>
  </div>

  <!-- Portrait Frame with crosshair registration marks -->
  <div class="ps-portrait-frame">

    {detectedPortraitPath ? (
      <img
        src={detectedPortraitPath}
        alt="Goutam Prusty — AI Engineer"
        width="480"
        height="600"
        class="ps-portrait-photo"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="ps-portrait-placeholder" aria-label="Professional portrait slot">
        <span class="ps-portrait-mono-initials">GP</span>
        <span class="ps-portrait-mono-role">AI ENGINEER</span>
      </div>
    )}

    <!-- Vignette to integrate photo with paper background -->
    <div class="ps-portrait-vignette" aria-hidden="true"></div>

    <!-- Observatory compass reticle composited in lower-left of frame -->
    <div class="ps-portrait-compass-overlay" aria-hidden="true">
      <svg
        viewBox="0 0 48 48"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        width="44"
        height="44"
        aria-hidden="true"
      >
        <!-- Outer calibration ring -->
        <circle cx="24" cy="24" r="22" stroke="#17191A" stroke-width="1.2" fill="#FDFCF8" fill-opacity="0.9" />
        <!-- Inner dashed ring -->
        <circle cx="24" cy="24" r="18.5" stroke="#827D71" stroke-width="0.7" stroke-dasharray="1 3" />
        <!-- Cardinal tick marks -->
        <line x1="24" y1="2" x2="24" y2="6.5" stroke="#17191A" stroke-width="1.5" />
        <line x1="24" y1="41.5" x2="24" y2="46" stroke="#17191A" stroke-width="1.5" />
        <line x1="2" y1="24" x2="6.5" y2="24" stroke="#17191A" stroke-width="1.5" />
        <line x1="41.5" y1="24" x2="46" y2="24" stroke="#17191A" stroke-width="1.5" />
        <!-- 45-degree azimuth ticks -->
        <line x1="8.5" y1="8.5" x2="11.5" y2="11.5" stroke="#827D71" stroke-width="0.9" />
        <line x1="39.5" y1="8.5" x2="36.5" y2="11.5" stroke="#827D71" stroke-width="0.9" />
        <line x1="8.5" y1="39.5" x2="11.5" y2="36.5" stroke="#827D71" stroke-width="0.9" />
        <line x1="39.5" y1="39.5" x2="36.5" y2="36.5" stroke="#827D71" stroke-width="0.9" />
        <!-- North directional arrow -->
        <polygon points="24,7 26.5,14 24,12.5 21.5,14" fill="#17191A" />
        <!-- N label -->
        <text x="24" y="20" font-family="'Cascadia Code', Consolas, monospace" font-size="5" font-weight="700" fill="#17191A" text-anchor="middle" letter-spacing="0.05em">N</text>
        <!-- Reticle centre — signal lime pip -->
        <circle cx="24" cy="24" r="5" fill="#D3F03C" stroke="#17191A" stroke-width="0.9" />
        <circle cx="24" cy="24" r="1.5" fill="#17191A" />
      </svg>
    </div>

    <!-- Crosshair corner marks (top-right, bottom-left positioned as absolute divs) -->
    <div class="ps-portrait-corner-tr" aria-hidden="true"></div>
    <div class="ps-portrait-corner-bl" aria-hidden="true"></div>
  </div>

  <!-- Editorial caption strip -->
  <div class="ps-portrait-caption" aria-hidden="true">
    <span class="ps-portrait-caption-name">Goutam Prusty · AI Engineer · Bengaluru</span>
    <span class="ps-portrait-caption-id">OBS.01</span>
  </div>

</div>
