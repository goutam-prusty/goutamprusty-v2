---
import {
  validateCapabilitiesData,
  hasValidCapabilities,
  validateLearningRoadmap,
  type CapabilitiesInput,
  type RawProjectCapability,
  type RawLearningCapability,
  type EligibleProjectSummary,
  type LearningRoadmapData,
} from '../lib/capabilities';

export interface Props {
  roadmap?: LearningRoadmapData;
  capabilities?: CapabilitiesInput;
  usedInProjects?: (RawProjectCapability | null | undefined)[];
  currentlyLearning?: (RawLearningCapability | string | null | undefined)[];
  eligibleProjects?: EligibleProjectSummary[];
  id?: string;
  class?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  roadmap: propRoadmap,
  capabilities: propCapabilities,
  usedInProjects: propUsedInProjects,
  currentlyLearning: propCurrentlyLearning,
  eligibleProjects,
  id: propId,
  class: className = '',
  eyebrow: propEyebrow,
  title: propTitle,
  description: propDescription,
} = Astro.props;

// 1. Check for Learning Roadmap mode
const validatedRoadmap = propRoadmap ? validateLearningRoadmap(propRoadmap) : null;
const isRoadmapMode = Boolean(validatedRoadmap);

// 2. Check for Evidence-based Capabilities mode
const inputData: CapabilitiesInput = propCapabilities || {
  usedInProjects: propUsedInProjects,
  currentlyLearning: propCurrentlyLearning,
};
const validatedCaps = validateCapabilitiesData(inputData, eligibleProjects);
const hasCaps = hasValidCapabilities(validatedCaps);

const renderable = isRoadmapMode || hasCaps;

const sectionId = propId || (isRoadmapMode ? 'learning-roadmap' : 'capabilities');
const sectionEyebrow = propEyebrow || (isRoadmapMode ? validatedRoadmap?.eyebrow : 'Capabilities & Practice');
const sectionTitle = propTitle || (isRoadmapMode ? validatedRoadmap?.title : 'Working Knowledge');
const sectionDesc = propDescription || (isRoadmapMode ? validatedRoadmap?.description : undefined);
---

{renderable && (
  <section class:list={['ps-section', 'ps-capabilities', isRoadmapMode && 'ps-learning-roadmap', className]} id={sectionId} aria-labelledby={`${sectionId}-title`}>
    <div class="ps-section-head">
      <div>
        {sectionEyebrow && <p class="ps-eyebrow">{sectionEyebrow}</p>}
        <h2 id={`${sectionId}-title`}>{sectionTitle}</h2>
      </div>
    </div>

    {/* Roadmap Presentation Mode (Owner-approved learning roadmap) */}
    {isRoadmapMode && validatedRoadmap && (
      <div class="ps-roadmap-container">
        {sectionDesc && (
          <p class="ps-roadmap-intro">{sectionDesc}</p>
        )}

        {/* 1. Core AI Engineering learning priorities (Strongest visual emphasis) */}
        <div class="ps-roadmap-tier ps-roadmap-tier--core" aria-labelledby={`${sectionId}-core-subhead`}>
          <div class="ps-roadmap-tier-head">
            <span class="ps-roadmap-tier-badge">High Priority</span>
            <h3 class="ps-roadmap-tier-title" id={`${sectionId}-core-subhead`}>
              {validatedRoadmap.corePrioritiesTitle}
            </h3>
            {validatedRoadmap.corePrioritiesDescription && (
              <p class="ps-roadmap-tier-desc">{validatedRoadmap.corePrioritiesDescription}</p>
            )}
          </div>
          <ul class="ps-roadmap-list ps-roadmap-list--core" role="list">
            {validatedRoadmap.corePriorities.map((item) => (
              <li class="ps-roadmap-item">
                <span class="ps-roadmap-tag ps-roadmap-tag--core">
                  <span class="ps-roadmap-bullet" aria-hidden="true">■</span>
                  <span class="ps-roadmap-name">{item}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        {/* 2. Supporting foundations and advanced learning areas (Normal visual emphasis) */}
        <div class="ps-roadmap-tier ps-roadmap-tier--supporting" aria-labelledby={`${sectionId}-supporting-subhead`}>
          <div class="ps-roadmap-tier-head">
            <h3 class="ps-roadmap-tier-title" id={`${sectionId}-supporting-subhead`}>
              {validatedRoadmap.supportingTitle}
            </h3>
            {validatedRoadmap.supportingDescription && (
              <p class="ps-roadmap-tier-desc">{validatedRoadmap.supportingDescription}</p>
            )}
          </div>

          <div class="ps-roadmap-subgroups-grid">
            {validatedRoadmap.supportingSubgroups.map((subgroup, idx) => (
              <div class="ps-roadmap-subgroup" aria-labelledby={`${sectionId}-sg-${idx}`}>
                <h4 class="ps-roadmap-subgroup-title" id={`${sectionId}-sg-${idx}`}>
                  {subgroup.title}
                </h4>
                <ul class="ps-roadmap-list ps-roadmap-list--supporting" role="list">
                  {subgroup.items.map((item) => (
                    <li class="ps-roadmap-item">
                      <span class="ps-roadmap-tag ps-roadmap-tag--supporting">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    {/* Evidence-Based Capabilities Mode (Project-demonstrated + In-progress study) */}
    {!isRoadmapMode && hasCaps && (
      <div class="ps-capabilities-grid">
        {validatedCaps.usedInProjects.length > 0 && (
          <div class="ps-capabilities-group" aria-labelledby={`${sectionId}-projects-subhead`}>
            <div class="ps-capabilities-group-head">
              <h3 class="ps-capabilities-subhead" id={`${sectionId}-projects-subhead`}>Used in projects</h3>
              <p class="ps-capabilities-desc">Demonstrated through real, verifiable project implementations.</p>
            </div>
            <ul class="ps-capabilities-list" role="list">
              {validatedCaps.usedInProjects.map((cap) => (
                <li class="ps-capabilities-item">
                  <a
                    class="ps-capability-tag ps-capability-tag--linked"
                    href={cap.projectUrl}
                    aria-label={`${cap.name} (demonstrated in ${cap.projectTitle})`}
                  >
                    <span class="ps-capability-name">{cap.name}</span>
                    <span class="ps-capability-project" aria-hidden="true">
                      {cap.projectTitle} <span class="ps-capability-arrow">↗</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {validatedCaps.currentlyLearning.length > 0 && (
          <div class="ps-capabilities-group" aria-labelledby={`${sectionId}-learning-subhead`}>
            <div class="ps-capabilities-group-head">
              <h3 class="ps-capabilities-subhead" id={`${sectionId}-learning-subhead`}>Currently learning</h3>
              <p class="ps-capabilities-desc">Actively exploring and deepening understanding through structured study.</p>
            </div>
            <ul class="ps-capabilities-list" role="list">
              {validatedCaps.currentlyLearning.map((cap) => (
                <li class="ps-capabilities-item">
                  <span class="ps-capability-tag ps-capability-tag--learning">
                    <span class="ps-capability-name">{cap.name}</span>
                    {cap.status && (
                      <span class="ps-capability-status" aria-hidden="true">
                        · {cap.status}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </section>
)}
