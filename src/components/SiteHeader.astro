---
const links = [
  { label: 'Home', href: '/' },
  { label: 'Research', href: '/research/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Topics', href: '/topics/' },
  { label: 'About', href: '/about/' },
];
const normalizePath = (path: string) => path.length > 1 ? path.replace(/\/+$/, '') : path;
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
  const targetPath = normalizePath(href);
  return targetPath === '/' ? currentPath === '/' : currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
};
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="goutamprusty.com home">goutamprusty.com</a>
  <details class="mobile-menu">
    <summary aria-label="Site navigation" aria-controls="mobile-navigation"><span></span><span></span></summary>
    <nav id="mobile-navigation" aria-label="Main navigation">
      {links.map((link) => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
  </details>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map((link) => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
</header>

<style>
  .site-header { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 2rem; min-height: 5rem; border-bottom: 1px solid var(--color-line); }
  .wordmark { color: var(--color-ink); font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; letter-spacing: -0.03em; text-decoration: none; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2.1rem); }
  .desktop-nav a, .mobile-menu nav a { color: var(--color-muted); font-size: 0.9rem; text-decoration: none; }
  .desktop-nav a:hover, .mobile-menu nav a:hover { color: var(--color-accent); }
  .mobile-menu { display: none; }
  @media (max-width: 48rem) {
    .site-header { min-height: 4.5rem; }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu summary { display: grid; align-content: center; gap: 0.32rem; width: 2.75rem; height: 2.75rem; padding: 0.65rem; border: 1px solid var(--color-line); border-radius: 0.25rem; cursor: pointer; list-style: none; }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span { height: 2px; background: var(--color-ink); }
    .mobile-menu[open] summary span:first-child { transform: translateY(0.16rem) rotate(45deg); }
    .mobile-menu[open] summary span:last-child { transform: translateY(-0.16rem) rotate(-45deg); }
    .mobile-menu nav { position: absolute; z-index: 2; inset: calc(100% + 1px) 0 auto; display: grid; gap: 0.25rem; padding: 0.75rem; border: 1px solid var(--color-line); background: var(--color-surface); box-shadow: 0 0.75rem 1.5rem rgb(36 38 34 / 8%); }
    .mobile-menu nav a { min-height: 2.75rem; display: flex; align-items: center; padding-inline: 0.75rem; }
  }
</style>
