---
import SiteLayout from './SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Metadata from '../components/Metadata.astro';
import RelatedWork from '../components/RelatedWork.astro';
import { fixtureNotice } from '../data/fixtures';
interface Section { id: string; title: string; body: string; }
interface Props { title: string; summary: string; type: string; sections?: Section[]; related?: { title: string; summary: string; href: string; type: string }[]; }
const { title, summary, type, sections = [], related = [] } = Astro.props as Props;
---
<SiteLayout title={`${title} | goutamprusty.com`}><article><PageIntro eyebrow="Development template" title={title} summary={summary} /><Metadata items={[type, fixtureNotice]} /><div class="optional-visual"><slot name="visual" /></div><div class="article-layout"><div class="prose"><p class="fixture-note">{fixtureNotice}</p>{sections.map((section) => <section id={section.id}><h2>{section.title}</h2><p>{section.body}</p></section>)}<slot /></div>{sections.length > 2 && <nav class="toc" aria-label="On this page"><h2>On this page</h2><ol>{sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>}</div><RelatedWork entries={related} /></article></SiteLayout>
<style>.optional-visual:empty{display:none}.optional-visual{max-width:var(--content-wide);margin:0 0 clamp(2rem,5vw,4rem)}.optional-visual:has(figure){max-width:var(--content-reading)}.article-layout{display:grid;grid-template-columns:minmax(0,var(--content-reading)) minmax(12rem,1fr);gap:clamp(2rem,6vw,5rem);align-items:start}.prose{min-width:0}.prose section{padding-block:1.5rem;border-bottom:1px solid var(--color-line)}.prose section:nth-child(even){padding-inline:clamp(1rem,3vw,2rem);background:var(--color-accent-soft)}.toc{position:sticky;top:1rem;border-left:1px solid var(--color-line);padding-left:1rem}.toc ol{padding-left:1rem}@media(max-width:48rem){.article-layout{grid-template-columns:1fr}.toc{position:static;grid-row:1}.prose section:nth-child(even){margin-inline:-.5rem}}</style>
