---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; }
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f8f7f3" />
    <meta name="description" content="Development-only design system preview." />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <SiteHeader />
      <main id="main"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .shell { width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide)); margin-inline: auto; }
  .skip-link { position: absolute; z-index: 5; top: 0.5rem; left: 0.5rem; transform: translateY(-160%); padding: 0.75rem 1rem; color: white; background: var(--color-ink); }
  .skip-link:focus { transform: translateY(0); }
</style>
