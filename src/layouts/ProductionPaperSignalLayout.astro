---
import '../styles/paper-signal.css';
import SiteFooter, { type SocialContactLinks } from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  socialLinks?: SocialContactLinks;
  aiDisclosure?: string | null;
  ogType?: 'website' | 'article';
  ogImage?: string | null;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const defaultSocialLinks: SocialContactLinks = {
  github: 'https://github.com/goutam-prusty',
  linkedin: 'https://www.linkedin.com/in/goutam-prusty/',
  medium: 'https://medium.com/@goutamprusty',
};

const {
  title,
  description,
  socialLinks = defaultSocialLinks,
  aiDisclosure,
  ogType = 'website',
  ogImage = null,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteBase = Astro.site?.toString() || 'https://goutamprusty.com';
const canonicalUrl = new URL(Astro.url.pathname, siteBase).toString();
const ogImageUrl = ogImage && typeof ogImage === 'string' && ogImage.trim().length > 0
  ? new URL(ogImage.trim(), siteBase).toString()
  : null;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const nav = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Skills', href: '/skills/' },
  { label: 'Research', href: '/research/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'About', href: '/about/' },
];

const normalizePath = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
  const targetPath = normalizePath(href);
  return targetPath === '/' ? currentPath === '/' : currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ec" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="goutamprusty.com" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <title>{title}</title>
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class="ps" id="top">
    <a class="ps-skip" href="#main">Skip to content</a>
    <div class="ps-shell">
      <header class="ps-header" id="ps-site-header">
        <a class="ps-wordmark" href="/" aria-label="goutamprusty.com home">g<span>.</span></a>

        <nav class="ps-desktop-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="ps-nav-link"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <details class="ps-nav-menu ps-mobile-nav" id="ps-mobile-nav-drawer">
          <summary aria-label="Open navigation menu"><span>Menu</span><span class="ps-menu-icon" aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobile navigation">
            <div class="ps-mobile-nav-close-row">
              <span class="ps-mobile-nav-heading">Navigation</span>
              <button
                class="ps-mobile-nav-close-btn"
                aria-label="Close navigation menu"
                onclick="this.closest('details').removeAttribute('open')"
              >✕</button>
            </div>
            {nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </details>

        <a
          class="ps-contact-link"
          href="/contact/"
          aria-current={isActive('/contact/') ? 'page' : undefined}
        >Get in touch</a>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <SiteFooter socialLinks={socialLinks} aiDisclosure={aiDisclosure} />
    </div>

    <script is:inline>
      (function () {
        var header = document.getElementById('ps-site-header');
        var drawer = document.getElementById('ps-mobile-nav-drawer');
        if (!header) return;

        var lastScrollY = window.scrollY;
        var ticking = false;
        var SCROLL_DOWN_THRESHOLD = 12;
        var SCROLL_UP_THRESHOLD = 8;
        var TOP_THRESHOLD = 48;

        function updateHeader() {
          var currentScrollY = window.scrollY;

          // Never hide header when mobile drawer is open
          if (drawer && drawer.hasAttribute('open')) {
            header.classList.remove('ps-header--hidden');
            lastScrollY = currentScrollY;
            ticking = false;
            return;
          }

          // Always visible at the top of the page; remove stuck shadow
          if (currentScrollY <= TOP_THRESHOLD) {
            header.classList.remove('ps-header--hidden');
            header.classList.remove('ps-header--stuck');
            lastScrollY = currentScrollY;
            ticking = false;
            return;
          }

          // Beyond top threshold -> stuck
          header.classList.add('ps-header--stuck');

          var delta = currentScrollY - lastScrollY;

          // Scroll down meaningfully -> hide smoothly
          if (delta > SCROLL_DOWN_THRESHOLD) {
            header.classList.add('ps-header--hidden');
            lastScrollY = currentScrollY;
          }
          // Scroll up meaningfully -> reveal immediately
          else if (delta < -SCROLL_UP_THRESHOLD) {
            header.classList.remove('ps-header--hidden');
            lastScrollY = currentScrollY;
          }

          ticking = false;
        }

        window.addEventListener(
          'scroll',
          function () {
            if (!ticking) {
              window.requestAnimationFrame(updateHeader);
              ticking = true;
            }
          },
          { passive: true }
        );

        // Auto-close mobile drawer on link selection
        if (drawer) {
          var navLinks = drawer.querySelectorAll('nav a');
          for (var i = 0; i < navLinks.length; i++) {
            navLinks[i].addEventListener('click', function () {
              drawer.removeAttribute('open');
            });
          }
        }

        // Expandable card buttons (description & tech tags)
        document.addEventListener('click', function (e) {
          var target = e.target;
          if (!target) return;
          var btn = target.closest('.ps-card-expand-btn');
          if (!btn) return;

          e.preventDefault();
          e.stopPropagation();

          var isExpanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!isExpanded));

          var targetId = btn.getAttribute('aria-controls');
          if (targetId) {
            var el = document.getElementById(targetId);
            if (el) {
              el.classList.toggle('ps-expanded', !isExpanded);
            }
          }

          var textSpan = btn.querySelector('.ps-expand-text');
          var iconSpan = btn.querySelector('.ps-expand-icon');

          if (btn.classList.contains('ps-desc-toggle')) {
            if (textSpan) textSpan.textContent = !isExpanded ? 'Less' : 'More';
            if (iconSpan) iconSpan.textContent = !isExpanded ? '−' : '+';
          } else if (btn.classList.contains('ps-tech-toggle')) {
            var overflowCount = btn.getAttribute('data-overflow-count') || '';
            if (textSpan) textSpan.textContent = !isExpanded ? 'Less' : '+' + overflowCount + ' More';
          }
        });

        // Card-level click navigation for playbook project cards
        document.addEventListener('click', function (e) {
          var target = e.target;
          if (!target) return;
          // Do not navigate if user clicked an anchor, button, or expand button
          if (target.closest('a, button, .ps-card-expand-btn')) return;

          // Do not navigate if user is selecting text
          var selection = window.getSelection();
          if (selection && selection.toString().length > 0) return;

          var card = target.closest('.ps-playbook-card');
          if (!card) return;

          var caseLink = card.querySelector('.ps-card-action--case-study');
          if (caseLink && caseLink.href) {
            // Respect modifier keys (Cmd/Ctrl/Shift/Alt) to open in a new tab
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
              window.open(caseLink.href, '_blank');
            } else {
              window.location.href = caseLink.href;
            }
          }
        });
      })();
    </script>
  </body>
</html>
