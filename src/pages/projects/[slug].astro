---
import ProductionPaperSignalLayout from '../../layouts/ProductionPaperSignalLayout.astro';
import PortableText from '../../components/PortableText.astro';
import CommandCenterVisual from '../../components/visuals/CommandCenterVisual.astro';
import RagPipelineVisual from '../../components/visuals/RagPipelineVisual.astro';
import { normalizeAssetPath } from '../../lib/pathNormalizer';
import { getImageDimensions } from '../../lib/imageDimensions';
import { formatProjectStatus } from '../../lib/projectCompatibility';
import { formatCategoryLabel } from '../../lib/formatters';
import {
  getAllProjectSlugs,
  getLocalDraftProjectPreview,
  getProjectBySlug,
  isLocalDraftPreviewEnabled,
} from '../../lib/sanityClient';

export async function getStaticPaths() {
  const slugs = await getAllProjectSlugs();
  const allSlugs = new Set(slugs);

  if (import.meta.env.DEV && isLocalDraftPreviewEnabled()) {
    const draftPreview = await getLocalDraftProjectPreview('ai-engineer-command-center');
    if (draftPreview?.slug?.current) {
      allSlugs.add(draftPreview.slug.current);
    }
  }

  return Array.from(allSlugs).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
let project = await getProjectBySlug(slug as string);
let isLocalDraftPreview = false;

if (!project && import.meta.env.DEV && isLocalDraftPreviewEnabled()) {
  project = await getLocalDraftProjectPreview(slug as string);
  isLocalDraftPreview = Boolean(project);
}

if (!project) {
  return Astro.redirect('/404');
}

const title = project.title;
const summary = project.summary;
const rawCategory = typeof project.category === 'string' ? project.category.trim() : '';
const category = formatCategoryLabel(rawCategory, 'Technology');
const statusLabel = formatProjectStatus(project.status, project);
const provenance = project.provenance;
const role = project.role;
const startDate = project.startDate;
const endDate = project.endDate;
const completedDate = project.completedDate;
const dateDisplay = [startDate, endDate || completedDate].filter(Boolean).join(' → ') || completedDate || startDate;
const techStack = Array.isArray(project.techStack) ? project.techStack : [];
const links = project.links || {};
const hasLinks = Boolean(links.repo || links.live || links.demo);
const coverImage = project.coverImage;
const coverSrc = coverImage?.assetPath ? normalizeAssetPath(coverImage.assetPath) : null;
const coverDims = coverSrc ? getImageDimensions(coverSrc) : null;
const aiAttribution = project.aiAttribution;
const evaluationNotes = project.evaluationNotes;
const bodyBlocks = Array.isArray(project.body) ? project.body : [];
const relatedResearch = Array.isArray(project.relatedResearch)
  ? project.relatedResearch.filter((item: any) => Boolean(item && (item.slug?.current || item.slug)))
  : [];
const relatedWriting = Array.isArray(project.relatedWriting)
  ? project.relatedWriting.filter((item: any) => Boolean(item && (item.slug?.current || item.slug)))
  : [];
const ogImage = coverImage?.assetPath ? normalizeAssetPath(coverImage.assetPath) : null;

// PRJ-004 Video Asset Detection
const isCommandCenter = slug === 'ai-engineer-command-center';
const isRagAssistant = slug === 'grounded-technical-docs-rag-assistant';
let commandCenterVideoSrc: { webm?: string; mp4?: string; poster?: string } | null = null;

if (isCommandCenter) {
  try {
    const proc = (globalThis as any).process;
    const fsModule: any = proc?.getBuiltinModule ? proc.getBuiltinModule('fs') : null;
    const pathModule: any = proc?.getBuiltinModule ? proc.getBuiltinModule('path') : null;
    if (fsModule && pathModule && proc?.cwd) {
      const videoDir = pathModule.resolve(proc.cwd(), 'public/videos');
      const webmExists = fsModule.existsSync(pathModule.join(videoDir, 'prj-004-command-center-demo.webm'));
      const mp4Exists = fsModule.existsSync(pathModule.join(videoDir, 'prj-004-command-center-demo.mp4'));
      const posterExists = fsModule.existsSync(pathModule.join(videoDir, 'prj-004-command-center-poster.webp'));
      if (webmExists || mp4Exists) {
        commandCenterVideoSrc = {
          webm: webmExists ? '/videos/prj-004-command-center-demo.webm' : undefined,
          mp4: mp4Exists ? '/videos/prj-004-command-center-demo.mp4' : undefined,
          poster: posterExists ? '/videos/prj-004-command-center-poster.webp' : undefined,
        };
      }
    }
  } catch {
    // build safety
  }
}

// Table of Contents Item Builder
const bodyHeadings = bodyBlocks
  .filter((b: any) => b._type === 'block' && (b.style === 'h2' || b.style === 'h3'))
  .map((b: any) => {
    const text = b.children?.map((c: any) => c.text || '').join('') || '';
    const id = text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').trim();
    return { id, title: text.trim(), level: b.style === 'h2' ? 2 : 3 };
  })
  .filter((h: any) => h.id && h.title);

const tocItems: Array<{ id: string; title: string }> = [];
if (isCommandCenter) {
  tocItems.push({ id: 'project-workspace-schematic', title: 'Workspace Schematic' });
  tocItems.push({ id: 'project-product-demonstration', title: 'Product Demonstration' });
}
if (isRagAssistant) {
  tocItems.push({ id: 'project-architecture-pipeline', title: 'Architecture Pipeline' });
}
if (techStack.length > 0) {
  tocItems.push({ id: 'project-tech-stack-heading', title: 'Technology Stack' });
}
if (aiAttribution) {
  tocItems.push({ id: 'project-ai-disclosure-heading', title: 'AI-Assistance Disclosure' });
}
if (evaluationNotes) {
  tocItems.push({ id: 'project-evaluation-heading', title: 'Evaluation & Observations' });
}
for (const h of bodyHeadings) {
  tocItems.push({ id: h.id, title: h.title });
}
if (relatedResearch.length > 0) {
  tocItems.push({ id: 'project-related-research', title: 'Related Research' });
}
if (relatedWriting.length > 0) {
  tocItems.push({ id: 'project-related-writing', title: 'Related Writing' });
}

const projectJsonLd: Record<string, unknown> | undefined = !isLocalDraftPreview
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: summary,
      author: {
        '@type': 'Person',
        name: 'Goutam Prusty',
        url: 'https://goutamprusty.com/',
      },
      mainEntityOfPage: `https://goutamprusty.com/projects/${slug}/`,
      ...(ogImage ? { image: new URL(ogImage, 'https://goutamprusty.com').toString() } : {}),
      ...(startDate ? { datePublished: startDate } : {}),
    }
  : undefined;
---

<ProductionPaperSignalLayout
  title={`${title} — goutamprusty.com`}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  noindex={isLocalDraftPreview}
  jsonLd={projectJsonLd}
>
  <div class="ps-page-head ps-article-head">
    {isLocalDraftPreview && (
      <p
        class="mb-3 px-3 py-1.5 text-xs font-mono uppercase tracking-wider inline-block"
        style="background: var(--color-sunken); border: 1px solid var(--color-line); color: var(--color-ink); border-radius: 2px;"
      >
        Local Draft Preview · Not Published
      </p>
    )}
    <p class="ps-eyebrow">Project · {provenance || category}</p>
    <h1>{title}</h1>
    {summary && (
      <p class="ps-lede">
        {summary}
      </p>
    )}
    <div class="ps-meta" style="border-top: 1px solid var(--color-line); padding-top: 0.75rem;">
      {statusLabel && <span><strong>Status</strong> {statusLabel}</span>}
      {rawCategory && <span><strong>Category</strong> {category}</span>}
      {role && <span><strong>Role</strong> {role}</span>}
      {provenance && <span><strong>Provenance</strong> {provenance}</span>}
      {dateDisplay && <span><strong>Timeline</strong> {dateDisplay}</span>}
      {project.workbookId && <span><strong>ID</strong> {project.workbookId}</span>}
    </div>
  </div>

  <div class="ps-body-grid ps-body-grid--project" style="padding-top: 2rem;">
    <article class="ps-article">
      {/* Mobile Table of Contents Disclosure */}
      {tocItems.length > 0 && (
        <nav class="ps-toc-mobile" aria-label="Table of contents">
          <details class="ps-toc-disclosure">
            <summary class="ps-toc-summary">
              <span>On this page</span>
              <span class="ps-toc-summary-badge">{tocItems.length} sections</span>
              <span class="ps-toc-summary-icon" aria-hidden="true">▾</span>
            </summary>
            <ol class="ps-toc-list">
              {tocItems.map((item) => (
                <li><a class="ps-touch-link" href={`#${item.id}`}>{item.title}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}

      {coverSrc && (
        <div
          class="my-8 overflow-hidden"
          style="border: 1px solid var(--color-line); background: var(--color-surface); border-radius: 2px;"
        >
          <img
            src={coverSrc}
            alt={coverImage.alt || title}
            width={coverDims?.width}
            height={coverDims?.height}
            class="w-full h-auto"
            loading="eager"
          />
        </div>
      )}

      {/* Schematic Architecture Visuals */}
      {isCommandCenter && (
        <section class="my-6" id="project-workspace-schematic" aria-labelledby="project-schematic-heading">
          <h2 id="project-schematic-heading" class="ps-section-label">Workspace Architecture Schematic</h2>
          <CommandCenterVisual />
        </section>
      )}

      {isRagAssistant && (
        <section class="my-6" id="project-architecture-pipeline" aria-labelledby="project-pipeline-heading">
          <h2 id="project-pipeline-heading" class="ps-section-label">System Architecture Pipeline</h2>
          <RagPipelineVisual />
          <p class="text-xs text-[var(--color-secondary)] mt-2 font-mono">
            System status: Implemented Python 3.12 / FastAPI foundation in solid stroke; planned retrieval & citation verification in dashed stroke.
          </p>
        </section>
      )}

      {/* Product Video / Walkthrough Slot for PRJ-004 */}
      {isCommandCenter && (
        <section class="my-8" id="project-product-demonstration" aria-labelledby="project-video-heading">
          <h2 id="project-video-heading" class="ps-section-label">Product Demonstration</h2>
          {commandCenterVideoSrc ? (
            <div class="overflow-hidden border border-[var(--color-line)] bg-black rounded-sm shadow-sm">
              <video
                controls
                preload="metadata"
                poster={commandCenterVideoSrc.poster}
                class="w-full h-auto aspect-video"
              >
                {commandCenterVideoSrc.webm && <source src={commandCenterVideoSrc.webm} type="video/webm" />}
                {commandCenterVideoSrc.mp4 && <source src={commandCenterVideoSrc.mp4} type="video/mp4" />}
                Your browser does not support HTML5 video.
              </video>
            </div>
          ) : (
            <div class="p-6 border border-[var(--color-line)] bg-[var(--color-surface)] rounded-sm">
              <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
                <span class="ps-card-badge ps-card-badge--status">Screen Recording Slot</span>
                <span class="text-xs font-mono text-[var(--color-secondary)]">20–30s Demonstration</span>
              </div>
              <p class="text-sm text-[var(--color-secondary)] mb-4 leading-relaxed">
                A live demonstration recording of the 20-week tracker, spaced revision deck, study session logger, and analytics engine. Place recording at <code class="text-xs bg-[var(--color-sunken)] px-1.5 py-0.5 rounded border border-[var(--color-line)]">/videos/prj-004-command-center-demo.webm</code>.
              </p>
              {links.live && (
                <a
                  href={links.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ps-card-action ps-card-action--case-study"
                >
                  <span>Open Live Application to Inspect Interface</span>
                  <span class="ps-action-icon" aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </section>
      )}

      {hasLinks && (
        <div
          class="my-6 p-4 flex flex-wrap gap-3 items-center"
          style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px;"
        >
          <span class="ps-eyebrow" style="margin: 0 0.25rem 0 0;">Links:</span>
          {links.live && (
            <a
              href={links.live}
              target="_blank"
              rel="noopener noreferrer"
              class="ps-card-action ps-card-action--case-study"
            >
              <span>Live Deployment</span>
              <span class="ps-action-icon" aria-hidden="true">↗</span>
            </a>
          )}
          {links.repo && (
            <a
              href={links.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="ps-card-action"
            >
              <span>Repository</span>
              <span class="ps-action-icon" aria-hidden="true">↗</span>
            </a>
          )}
          {links.demo && (
            <a
              href={links.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="ps-card-action"
            >
              <span>Demo</span>
              <span class="ps-action-icon" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      )}

      {techStack.length > 0 && (
        <section class="my-6" id="project-tech-stack-heading" aria-labelledby="project-tech-stack-heading">
          <h2 class="ps-section-label">Technology Stack</h2>
          <ul class="ps-card-stack" style="margin-top: 0.75rem; margin-bottom: 0;">
            {techStack.map((tech: string) => (
              <li class="ps-card-stack-tag">
                {tech}
              </li>
            ))}
          </ul>
        </section>
      )}

      {aiAttribution && (
        <section class="ps-note my-8" id="project-ai-disclosure-heading" aria-labelledby="project-ai-disclosure-heading">
          <h2 class="ps-section-label">AI-Assistance Disclosure</h2>
          <p class="text-sm leading-relaxed" style="margin-bottom: 0;">{aiAttribution}</p>
        </section>
      )}

      {evaluationNotes && (
        <section
          class="my-8 p-4"
          id="project-evaluation-heading"
          style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px; color: var(--color-ink);"
          aria-labelledby="project-evaluation-heading"
        >
          <h2 class="ps-section-label">Evaluation &amp; Observations</h2>
          <p class="text-sm leading-relaxed" style="margin-bottom: 0;">{evaluationNotes}</p>
        </section>
      )}

      {bodyBlocks.length > 0 && (
        <section class="my-8" aria-label="Case study body">
          <PortableText blocks={bodyBlocks} />
        </section>
      )}

      {relatedResearch.length > 0 && (
        <section class="mt-12 pt-8" id="project-related-research" style="border-top: 1px solid var(--color-line);" aria-label="Related research">
          <p class="ps-eyebrow" style="margin-bottom: 0.75rem;">Related Research</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {relatedResearch.map((item: any) => {
              const itemSlug = item.slug?.current || item.slug;
              return (
                <a
                  href={`/research/${itemSlug}/`}
                  class="block p-4 transition-colors"
                  style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px; text-decoration: none;"
                >
                  <h3 style="margin-top: 0; font-size: 1.15rem;">{item.title}</h3>
                  {item.summary && <p class="text-xs line-clamp-2" style="color: var(--color-secondary); margin-bottom: 0;">{item.summary}</p>}
                </a>
              );
            })}
          </div>
        </section>
      )}

      {relatedWriting.length > 0 && (
        <section class="mt-12 pt-8" id="project-related-writing" style="border-top: 1px solid var(--color-line);" aria-label="Related writing">
          <p class="ps-eyebrow" style="margin-bottom: 0.75rem;">Related Writing</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {relatedWriting.map((item: any) => {
              const itemSlug = item.slug?.current || item.slug;
              return (
                <a
                  href={`/writing/${itemSlug}/`}
                  class="block p-4 transition-colors"
                  style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px; text-decoration: none;"
                >
                  <h3 style="margin-top: 0; font-size: 1.15rem;">{item.title}</h3>
                  {item.summary && <p class="text-xs line-clamp-2" style="color: var(--color-secondary); margin-bottom: 0;">{item.summary}</p>}
                </a>
              );
            })}
          </div>
        </section>
      )}

      <nav class="mt-8 pt-4" aria-label="Project navigation">
        <a href="/projects/" class="ps-text-link ps-touch-link text-sm font-mono hover:underline">
          ← Return to all projects
        </a>
      </nav>
    </article>

    {/* Sticky Desktop Aside (Table of Contents + Quick Facts) */}
    {tocItems.length > 0 && (
      <aside class="ps-aside ps-aside--project" aria-label="Project case study sections">
        <div class="ps-aside-block">
          <h2>Quick Facts</h2>
          <div class="ps-aside-meta">
            {statusLabel && (
              <div class="ps-aside-meta-row">
                <span class="ps-aside-meta-label">Status</span>
                <span class="ps-aside-meta-val">{statusLabel}</span>
              </div>
            )}
            <div class="ps-aside-meta-row">
              <span class="ps-aside-meta-label">Category</span>
              <span class="ps-aside-meta-val">{category}</span>
            </div>
            {provenance && (
              <div class="ps-aside-meta-row">
                <span class="ps-aside-meta-label">Provenance</span>
                <span class="ps-aside-meta-val">{provenance}</span>
              </div>
            )}
            {project.workbookId && (
              <div class="ps-aside-meta-row">
                <span class="ps-aside-meta-label">ID</span>
                <span class="ps-aside-meta-val font-mono">{project.workbookId}</span>
              </div>
            )}
          </div>
        </div>

        <div class="ps-aside-block mt-5 pt-5" style="border-top: 1px solid var(--color-line);">
          <h2>On this page</h2>
          <ol class="ps-aside-toc-list">
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.title}</a>
              </li>
            ))}
          </ol>
        </div>

        {hasLinks && (
          <div class="ps-aside-block mt-5 pt-5" style="border-top: 1px solid var(--color-line);">
            <h2>Project Links</h2>
            <div class="flex flex-col gap-2 mt-2">
              {links.live && (
                <a href={links.live} target="_blank" rel="noopener noreferrer" class="ps-card-action ps-card-action--case-study text-xs">
                  <span>Live Deployment</span>
                  <span class="ps-action-icon" aria-hidden="true">↗</span>
                </a>
              )}
              {links.repo && (
                <a href={links.repo} target="_blank" rel="noopener noreferrer" class="ps-card-action text-xs">
                  <span>GitHub Repository</span>
                  <span class="ps-action-icon" aria-hidden="true">↗</span>
                </a>
              )}
              {links.demo && (
                <a href={links.demo} target="_blank" rel="noopener noreferrer" class="ps-card-action text-xs">
                  <span>Demo</span>
                  <span class="ps-action-icon" aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        )}
      </aside>
    )}
  </div>
</ProductionPaperSignalLayout>

<style>
  .ps-aside-meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.6rem;
  }
  .ps-aside-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.82rem;
  }
  .ps-aside-meta-label {
    color: var(--color-secondary);
    font-weight: 500;
  }
  .ps-aside-meta-val {
    color: var(--color-ink);
    font-weight: 600;
    text-align: right;
  }
  .ps-aside-toc-list {
    margin: 0.4rem 0 0;
    padding-left: 1.15rem;
    list-style: decimal;
  }
  .ps-aside-toc-list li {
    margin-block: 0.25rem;
    font-size: 0.84rem;
  }
  .ps-aside-toc-list li a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.2rem;
  }
  .ps-aside-toc-list li a:hover {
    text-decoration-color: var(--color-ink);
  }
  @media (max-width: 52rem) {
    .ps-aside--project {
      display: none;
    }
  }
</style>
