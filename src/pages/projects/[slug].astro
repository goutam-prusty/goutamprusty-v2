---
import ProductionPaperSignalLayout from '../../layouts/ProductionPaperSignalLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { normalizeAssetPath } from '../../lib/pathNormalizer';
import { getImageDimensions } from '../../lib/imageDimensions';
import { formatProjectStatus } from '../../lib/projectCompatibility';
import {
  getAllProjectSlugs,
  getLocalDraftProjectPreview,
  getProjectBySlug,
  isLocalDraftPreviewEnabled,
} from '../../lib/sanityClient';

export async function getStaticPaths() {
  const slugs = await getAllProjectSlugs();
  const allSlugs = new Set(slugs);

  if (import.meta.env.DEV && isLocalDraftPreviewEnabled()) {
    const draftPreview = await getLocalDraftProjectPreview('ai-engineer-command-center');
    if (draftPreview?.slug?.current) {
      allSlugs.add(draftPreview.slug.current);
    }
  }

  return Array.from(allSlugs).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
let project = await getProjectBySlug(slug as string);
let isLocalDraftPreview = false;

if (!project && import.meta.env.DEV && isLocalDraftPreviewEnabled()) {
  project = await getLocalDraftProjectPreview(slug as string);
  isLocalDraftPreview = Boolean(project);
}

if (!project) {
  return Astro.redirect('/404');
}

const title = project.title;
const summary = project.summary;
const rawCategory = typeof project.category === 'string' ? project.category.trim() : '';
const category = rawCategory || 'Technology';
const statusLabel = formatProjectStatus(project.status, project);
const provenance = project.provenance;
const role = project.role;
const startDate = project.startDate;
const endDate = project.endDate;
const completedDate = project.completedDate;
const dateDisplay = [startDate, endDate || completedDate].filter(Boolean).join(' → ') || completedDate || startDate;
const techStack = Array.isArray(project.techStack) ? project.techStack : [];
const links = project.links || {};
const hasLinks = Boolean(links.repo || links.live || links.demo);
const coverImage = project.coverImage;
const coverSrc = coverImage?.assetPath ? normalizeAssetPath(coverImage.assetPath) : null;
const coverDims = coverSrc ? getImageDimensions(coverSrc) : null;
const aiAttribution = project.aiAttribution;
const evaluationNotes = project.evaluationNotes;
const bodyBlocks = Array.isArray(project.body) ? project.body : [];
const relatedResearch = Array.isArray(project.relatedResearch)
  ? project.relatedResearch.filter((item: any) => Boolean(item && (item.slug?.current || item.slug)))
  : [];
const relatedWriting = Array.isArray(project.relatedWriting)
  ? project.relatedWriting.filter((item: any) => Boolean(item && (item.slug?.current || item.slug)))
  : [];
const ogImage = coverImage?.assetPath ? normalizeAssetPath(coverImage.assetPath) : null;
const projectJsonLd: Record<string, unknown> | undefined = !isLocalDraftPreview
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: summary,
      author: {
        '@type': 'Person',
        name: 'Goutam Prusty',
        url: 'https://goutamprusty.com/',
      },
      mainEntityOfPage: `https://goutamprusty.com/projects/${slug}/`,
      ...(ogImage ? { image: new URL(ogImage, 'https://goutamprusty.com').toString() } : {}),
      ...(startDate ? { datePublished: startDate } : {}),
    }
  : undefined;
---

<ProductionPaperSignalLayout
  title={`${title} — goutamprusty.com`}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  noindex={isLocalDraftPreview}
  jsonLd={projectJsonLd}
>
  <div class="ps-page-head ps-article-head">
    {isLocalDraftPreview && (
      <p
        class="mb-3 px-3 py-1.5 text-xs font-mono uppercase tracking-wider inline-block"
        style="background: var(--color-sunken); border: 1px solid var(--color-line); color: var(--color-ink); border-radius: 2px;"
      >
        Local Draft Preview · Not Published
      </p>
    )}
    <p class="ps-eyebrow">Project · {provenance || category}</p>
    <h1>{title}</h1>
    {summary && (
      <p class="ps-lede">
        {summary}
      </p>
    )}
    <div class="ps-meta" style="border-top: 1px solid var(--color-line); padding-top: 0.75rem;">
      {statusLabel && <span><strong>Status</strong> {statusLabel}</span>}
      {rawCategory && <span><strong>Category</strong> {rawCategory}</span>}
      {role && <span><strong>Role</strong> {role}</span>}
      {provenance && <span><strong>Provenance</strong> {provenance}</span>}
      {dateDisplay && <span><strong>Timeline</strong> {dateDisplay}</span>}
      {project.workbookId && <span><strong>ID</strong> {project.workbookId}</span>}
    </div>
  </div>

  <div class="my-8">
    <article class="ps-article">
      {coverSrc && (
        <div
          class="my-8 overflow-hidden"
          style="border: 1px solid var(--color-line); background: var(--color-surface); border-radius: 2px;"
        >
          <img
            src={coverSrc}
            alt={coverImage.alt || title}
            width={coverDims?.width}
            height={coverDims?.height}
            class="w-full h-auto"
            loading="eager"
          />
        </div>
      )}

      {hasLinks && (
        <div
          class="my-6 p-4 flex flex-wrap gap-3 items-center"
          style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px;"
        >
          <span class="ps-eyebrow" style="margin: 0 0.25rem 0 0;">Links:</span>
          {links.live && (
            <a
              href={links.live}
              target="_blank"
              rel="noopener noreferrer"
              class="ps-card-action ps-card-action--case-study"
            >
              <span>Live Deployment</span>
              <span class="ps-action-icon" aria-hidden="true">↗</span>
            </a>
          )}
          {links.repo && (
            <a
              href={links.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="ps-card-action"
            >
              <span>Repository</span>
              <span class="ps-action-icon" aria-hidden="true">↗</span>
            </a>
          )}
          {links.demo && (
            <a
              href={links.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="ps-card-action"
            >
              <span>Demo</span>
              <span class="ps-action-icon" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      )}

      {techStack.length > 0 && (
        <section class="my-6" aria-labelledby="project-tech-stack-heading">
          <h2 id="project-tech-stack-heading" class="ps-section-label">Technology Stack</h2>
          <ul class="ps-card-stack" style="margin-top: 0.75rem; margin-bottom: 0;">
            {techStack.map((tech: string) => (
              <li class="ps-card-stack-tag">
                {tech}
              </li>
            ))}
          </ul>
        </section>
      )}

      {aiAttribution && (
        <section class="ps-note my-8" aria-labelledby="project-ai-disclosure-heading">
          <h2 id="project-ai-disclosure-heading" class="ps-section-label">AI-Assistance Disclosure</h2>
          <p class="text-sm leading-relaxed" style="margin-bottom: 0;">{aiAttribution}</p>
        </section>
      )}

      {evaluationNotes && (
        <section
          class="my-8 p-4"
          style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px; color: var(--color-ink);"
          aria-labelledby="project-evaluation-heading"
        >
          <h2 id="project-evaluation-heading" class="ps-section-label">Evaluation &amp; Observations</h2>
          <p class="text-sm leading-relaxed" style="margin-bottom: 0;">{evaluationNotes}</p>
        </section>
      )}

      {bodyBlocks.length > 0 && (
        <section class="my-8" aria-label="Case study body">
          <PortableText blocks={bodyBlocks} />
        </section>
      )}

      {relatedResearch.length > 0 && (
        <section class="mt-12 pt-8" style="border-top: 1px solid var(--color-line);" aria-label="Related research">
          <p class="ps-eyebrow" style="margin-bottom: 0.75rem;">Related Research</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {relatedResearch.map((item: any) => {
              const itemSlug = item.slug?.current || item.slug;
              return (
                <a
                  href={`/research/${itemSlug}/`}
                  class="block p-4 transition-colors"
                  style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px; text-decoration: none;"
                >
                  <h3 style="margin-top: 0; font-size: 1.15rem;">{item.title}</h3>
                  {item.summary && <p class="text-xs line-clamp-2" style="color: var(--color-secondary); margin-bottom: 0;">{item.summary}</p>}
                </a>
              );
            })}
          </div>
        </section>
      )}

      {relatedWriting.length > 0 && (
        <section class="mt-12 pt-8" style="border-top: 1px solid var(--color-line);" aria-label="Related writing">
          <p class="ps-eyebrow" style="margin-bottom: 0.75rem;">Related Writing</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {relatedWriting.map((item: any) => {
              const itemSlug = item.slug?.current || item.slug;
              return (
                <a
                  href={`/writing/${itemSlug}/`}
                  class="block p-4 transition-colors"
                  style="background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 2px; text-decoration: none;"
                >
                  <h3 style="margin-top: 0; font-size: 1.15rem;">{item.title}</h3>
                  {item.summary && <p class="text-xs line-clamp-2" style="color: var(--color-secondary); margin-bottom: 0;">{item.summary}</p>}
                </a>
              );
            })}
          </div>
        </section>
      )}

      <nav class="mt-12 pt-6" style="border-top: 1px solid var(--color-line);" aria-label="Project navigation">
        <a href="/projects/" class="ps-text-link ps-touch-link text-sm font-mono hover:underline">
          ← Return to all projects
        </a>
      </nav>
    </article>
  </div>
</ProductionPaperSignalLayout>
