---
import ProductionPaperSignalLayout from '../layouts/ProductionPaperSignalLayout.astro';

const title = 'Contact';
const summary = 'Inquiries, research discussions, and technical exchanges.';
---

<ProductionPaperSignalLayout
  title="Contact — goutamprusty.com"
  description={summary}
>
  <header class="ps-page-head">
    <p class="ps-eyebrow">Inquiries &amp; Exchange</p>
    <h1>{title}</h1>
    <p class="ps-lede">{summary}</p>
  </header>

  <section class="ps-section" aria-label="Contact information">
    <div class="ps-note" style="max-width: var(--reading);">
      <p style="margin: 0;">Whether discussing frontier research, technical methodology, or potential collaboration, genuine inquiries are welcome. Official communication channels will be published here upon full release.</p>
    </div>
  </section>
</ProductionPaperSignalLayout>
