---
import ProductionPaperSignalLayout from '../layouts/ProductionPaperSignalLayout.astro';

const title = 'Contact';
const summary = 'Inquiries, research discussions, and technical exchanges.';
---

<ProductionPaperSignalLayout
  title="Contact — goutamprusty.com"
  description={summary}
>
  <header class="ps-page-head">
    <p class="ps-eyebrow">Inquiries &amp; Exchange</p>
    <h1>{title}</h1>
    <p class="ps-lede">{summary}</p>
  </header>

  <section class="ps-section" aria-labelledby="direct-contact-heading">
    <p class="ps-eyebrow">Direct</p>
    <h2 id="direct-contact-heading">Email</h2>
    <p style="max-width: var(--reading);">
      For engineering opportunities, technical questions, or research correspondence, reach out directly by email.
    </p>
    <div style="margin-top: 1.25rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem;">
      <a
        class="ps-button"
        href="mailto:hello@goutamprusty.com"
        aria-label="Send primary email to hello@goutamprusty.com"
      >
        hello@goutamprusty.com <span aria-hidden="true">↗</span>
      </a>
      <p class="ps-muted" style="margin: 0; font-size: 0.88rem;">
        Secondary email:
        <a
          href="mailto:goutamprusty6919@gmail.com"
          class="ps-text-link"
          style="font-size: 0.88rem; margin-left: 0.25rem;"
          aria-label="Send secondary email to goutamprusty6919@gmail.com"
        >
          goutamprusty6919@gmail.com
        </a>
      </p>
    </div>
  </section>

  <section class="ps-section" aria-labelledby="profiles-heading">
    <p class="ps-eyebrow">Elsewhere</p>
    <h2 id="profiles-heading">Profiles &amp; External Writing</h2>
    <ul class="ps-link-list" style="max-width: var(--reading); margin-top: 1rem;">
      <li>
        <a
          href="https://github.com/goutam-prusty"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Goutam Prusty on GitHub (opens in new tab)"
        >
          <span class="ps-link-item-text">
            <strong class="ps-link-title">GitHub</strong>
            <span class="ps-link-desc">Public repositories and source code</span>
          </span>
          <span class="ps-arrow-link" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/goutam-prusty/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Goutam Prusty on LinkedIn (opens in new tab)"
        >
          <span class="ps-link-item-text">
            <strong class="ps-link-title">LinkedIn</strong>
            <span class="ps-link-desc">Professional background and updates</span>
          </span>
          <span class="ps-arrow-link" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <a
          href="https://medium.com/@goutamprusty"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Goutam Prusty on Medium (opens in new tab)"
        >
          <span class="ps-link-item-text">
            <strong class="ps-link-title">Medium</strong>
            <span class="ps-link-desc">External writing profile</span>
          </span>
          <span class="ps-arrow-link" aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </section>
</ProductionPaperSignalLayout>
