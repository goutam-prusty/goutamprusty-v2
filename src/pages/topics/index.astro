---
import ProductionPaperSignalLayout from '../../layouts/ProductionPaperSignalLayout.astro';

const title = 'Topics';
const summary = 'Subject index and thematic taxonomy for research and writing.';
---

<ProductionPaperSignalLayout
  title="Topics — goutamprusty.com"
  description={summary}
>
  <header class="ps-page-head">
    <p class="ps-eyebrow">Taxonomy · Research &amp; Writing</p>
    <h1>{title}</h1>
    <p class="ps-lede">{summary}</p>
  </header>

  <section class="ps-section" aria-label="Topics">
    <div class="ps-empty-state border border-stone-200 bg-stone-50 p-8 rounded text-center my-8">
      <p class="text-stone-700 font-serif text-lg mb-2">Topic taxonomy is currently being structured.</p>
      <p class="text-stone-500 text-sm font-sans">Verified subject taxonomy and linked research dossiers will appear here once published.</p>
    </div>
  </section>
</ProductionPaperSignalLayout>
