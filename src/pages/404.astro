---
import ProductionPaperSignalLayout from '../layouts/ProductionPaperSignalLayout.astro';

const title = 'Page not found';
const summary = 'The address may be incorrect or the page may have moved.';
---

<ProductionPaperSignalLayout
  title={`${title} — goutamprusty.com`}
  description={summary}
  noindex={true}
>
  <div class="ps-page-head">
    <p class="ps-eyebrow">404 · Error</p>
    <h1>This page could not be found.</h1>
    <p class="ps-lede">{summary}</p>
  </div>

  <section class="ps-section" aria-label="Recovery navigation">
    <div class="ps-actions">
      <a href="/" class="ps-button">
        Return to the homepage <span aria-hidden="true">→</span>
      </a>
      <a href="/research/" class="ps-text-link">
        Browse research <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</ProductionPaperSignalLayout>
