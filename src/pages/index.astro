---
import ProductionPaperSignalLayout from '../layouts/ProductionPaperSignalLayout.astro';
import {
  getAllProjects,
  getResearchReportBySlug,
  getWritingArticleBySlug,
} from '../lib/sanityClient';
import { getArticleReadingTime } from '../lib/readingTime';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsOverview from '../components/SkillsOverview.astro';
import ObservatoryHeroPortrait from '../components/ObservatoryHeroPortrait.astro';
import EditorialCarousel from '../components/EditorialCarousel.astro';
import RecruiterEngagement from '../components/RecruiterEngagement.astro';
import { normalizeAssetPath } from '../lib/pathNormalizer';

// 1. Projects Data (Sanity-backed T4 integration)
const allProjects = await getAllProjects();
// Only eligible featured projects for homepage display (PRJ-004 published leads over PRJ-005 in-dev)
const sortedProjects = [...allProjects].sort((a: any, b: any) => {
  const isACommandCenter = a.workbookId === 'PRJ-004' || a.slug?.current === 'ai-engineer-command-center' || a.slug === 'ai-engineer-command-center';
  const isBCommandCenter = b.workbookId === 'PRJ-004' || b.slug?.current === 'ai-engineer-command-center' || b.slug === 'ai-engineer-command-center';
  if (isACommandCenter && !isBCommandCenter) return -1;
  if (!isACommandCenter && isBCommandCenter) return 1;
  return 0;
});
const featuredProjects = sortedProjects.filter((p: any) => p.featured || p.legacyFeatured);

// 2. Verified Research and Writing selections (curated 4 pieces: 2 research + 2 writing)
const res018Slug = 'strategic-intelligence-report-the-state-of-artificial-intelligence-and-frontier-technologies-in-2026';
const res004Slug = 'indias-digital-governance-ecosystem-evaluation';
const blg001Slug = 'agentic-inflection-point';
const blg002Slug = 'ai-physical-limits';

const [res018, res004, blg001, blg002] = await Promise.all([
  getResearchReportBySlug(res018Slug),
  getResearchReportBySlug(res004Slug),
  getWritingArticleBySlug(blg001Slug),
  getWritingArticleBySlug(blg002Slug),
]);

const resTitle = res018?.title || 'Strategic Intelligence Report: The State of Artificial Intelligence and Frontier Technologies in 2026';
const resSummary = res018?.summary || 'A comprehensive 2026 strategic briefing on AI progress, compute constraints, reasoning models, enterprise ROI, and sovereign technology developments.';
const resLength = (res018?.lengthEstimateMinutes || 15) + ' min read';
const resCitations = Array.isArray(res018?.bibliography) ? `${res018.bibliography.length} citations` : '71 citations';

const res004Title = res004?.title || "India's Digital Governance Ecosystem Evaluation";
const res004Summary = res004?.summary || "An empirical evaluation of India's Digital Public Infrastructure, assessing economic impact, digital divides, privacy, and cybersecurity.";
const res004Length = (res004?.lengthEstimateMinutes || 15) + ' min read';
const res004Citations = Array.isArray(res004?.bibliography) ? `${res004.bibliography.length} citations` : '97 citations';

const blg1Title = blg001?.title || 'The Agentic Inflection Point';
const blg1Summary = blg001?.summary || 'A strategic analysis of where autonomous AI systems actually are, the capability gaps that remain, and what the trajectory implies for organizations.';
const blg1Length = getArticleReadingTime(blg001);

const blg2Title = blg002?.title || "AI's Physical Limits";
const blg2Summary = blg002?.summary || "Why energy, transmission, cooling, and silicon manufacturing — not algorithmic ceilings — represent the binding constraints on frontier AI expansion.";
const blg2Length = getArticleReadingTime(blg002) || '11 min read';

// Genuine Cover Image Resolution (Stage 2: Editorial Cover Cards)
const res018Cover = res018?.coverImage?.assetPath ? normalizeAssetPath(res018.coverImage.assetPath) : null;
const res004Cover = res004?.coverImage?.assetPath ? normalizeAssetPath(res004.coverImage.assetPath) : null;
const blg001Cover = blg001?.coverImage?.assetPath ? normalizeAssetPath(blg001.coverImage.assetPath) : null;
const blg002Cover = blg002?.coverImage?.assetPath ? normalizeAssetPath(blg002.coverImage.assetPath) : null;

const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'goutamprusty.com',
    url: 'https://goutamprusty.com/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Goutam Prusty',
    url: 'https://goutamprusty.com/',
    sameAs: [
      'https://github.com/goutam-prusty',
      'https://www.linkedin.com/in/goutam-prusty/',
      'https://medium.com/@goutamprusty',
    ],
  },
];

// Inline SVG arrow — replaces Unicode → for consistent cross-platform alignment
const ArrowRight = `<svg aria-hidden="true" focusable="false" width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline-block;vertical-align:middle;flex-shrink:0"><path d="M2 6.5h9M7.5 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<ProductionPaperSignalLayout
  title="Goutam Prusty — AI Engineer"
  description="AI Engineering portfolio — projects, technical skills, research, and writing by Goutam Prusty. Based in Bengaluru."
  jsonLd={homeJsonLd}
>
  {/* 1. Hero */}
  <section class="ps-hero" aria-labelledby="hero-title">
    <div class="ps-hero-copy">
      <p class="ps-eyebrow">AI Engineer</p>
      <h1 id="hero-title">Curiosity, made <em>useful.</em></h1>
      <p class="ps-hero-hook">Looking for signs of consciousness.</p>
      <p class="ps-lede">
        I explore intelligence, computing, and the systems shaping emerging technology through research and hands-on software projects. I turn questions into things I can test, build, and improve. I believe there is always more to understand and that's what keeps me curious.
      </p>
      <div class="ps-actions">
        <a class="ps-button" href="/projects/">
          View Projects
          <span aria-hidden="true" set:html={ArrowRight}></span>
        </a>
        <a class="ps-text-link" href="/about/">
          About Goutam
          <span aria-hidden="true" set:html={ArrowRight}></span>
        </a>
      </div>
    </div>
    <ObservatoryHeroPortrait />
  </section>

  {/* 2. Featured Projects */}
  {featuredProjects.length > 0 && (
    <section class="ps-section" id="featured-projects" aria-labelledby="featured-projects-title">
      <div class="ps-section-head">
        <div>
          <p class="ps-eyebrow">Engineering &amp; Systems</p>
          <h2 id="featured-projects-title">Featured Projects</h2>
        </div>
        <a class="ps-text-link" href="/projects/">
          Explore all projects
          <span aria-hidden="true" set:html={ArrowRight}></span>
        </a>
      </div>
      <EditorialCarousel
        id="featured-projects-carousel"
        label="Featured Projects"
        totalSlides={featuredProjects.length}
      >
        {featuredProjects.map((project: any, idx: number) => (
          <ProjectCard project={project} index={idx} />
        ))}
      </EditorialCarousel>
    </section>
  )}

  {/* 3. Technical Skills Overview — Chapter: sage technical field */}
  <SkillsOverview id="skills-overview" class="ps-section--chapter-skills" />

  {/* 4. Research & Writing */}
  <section class="ps-section" id="research-writing" aria-labelledby="research-writing-title">
    <div class="ps-section-head">
      <div>
        <p class="ps-eyebrow">Curated briefings &amp; analysis</p>
        <h2 id="research-writing-title">Research &amp; Writing</h2>
      </div>
      <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
        <a class="ps-text-link" href="/research/">
          Explore all research
          <span aria-hidden="true" set:html={ArrowRight}></span>
        </a>
        <a class="ps-text-link" href="/writing/">
          Browse all writing
          <span aria-hidden="true" set:html={ArrowRight}></span>
        </a>
      </div>
    </div>
    <EditorialCarousel
      id="research-writing-carousel"
      label="Research & Writing"
      totalSlides={4}
    >
      <a class="ps-project-card ps-card-editorial ps-card-research ps-card-journal" href={`/research/${res018Slug}/`}>
        <div class="ps-card-top">
          <span class="ps-card-mark" aria-hidden="true">01</span>
          <div class="ps-card-badges">
            <span class="ps-card-badge">Research report</span>
          </div>
        </div>

        <div class="ps-journal-cover" aria-hidden="true">
          {res018Cover ? (
            <img
              src={res018Cover}
              alt=""
              class="ps-journal-cover-img"
              loading="lazy"
              decoding="async"
              width="640"
              height="360"
            />
          ) : (
            <div class="ps-journal-cover-fallback">
              <svg viewBox="0 0 640 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="ps-journal-fallback-svg" role="img" aria-label="Observatory figure fallback">
                <rect width="640" height="360" fill="#FDFCF8" stroke="#17191A" stroke-width="1" />
                <line x1="0" y1="180" x2="640" y2="180" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <line x1="320" y1="0" x2="320" y2="360" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <circle cx="320" cy="180" r="90" stroke="#17191A" stroke-width="1.2" fill="none" />
                <circle cx="320" cy="180" r="60" stroke="#827D71" stroke-width="0.8" stroke-dasharray="2 3" fill="none" />
                <circle cx="320" cy="180" r="4" fill="#D3F03C" stroke="#17191A" stroke-width="1" />
                <text x="320" y="295" font-family="'Cascadia Code', Consolas, monospace" font-size="11" font-weight="700" fill="#4A4F4C" text-anchor="middle" letter-spacing="0.12em">FIELD BRIEFING ARCHIVE</text>
              </svg>
            </div>
          )}
          <div class="ps-journal-cover-overlay"></div>
          <div class="ps-journal-cover-plate">
            <span>FIG // 01 · RES-018</span>
          </div>
          <div class="ps-journal-cover-coord">
            <span>OBS // 12.97° N</span>
          </div>
        </div>

        <div class="ps-card-content-wrap">
          <p class="ps-kicker">Research · RES-018 · July 2026</p>
          <h3>{resTitle}</h3>
          <p>{resSummary}</p>
        </div>

        <span class="ps-card-foot">
          <span>{resLength} · {resCitations}</span>
          <span class="ps-foot-action" aria-hidden="true">Read report <span class="ps-action-icon">→</span></span>
        </span>
      </a>

      <a class="ps-project-card ps-card-editorial ps-card-research ps-card-journal" href={`/research/${res004Slug}/`}>
        <div class="ps-card-top">
          <span class="ps-card-mark" aria-hidden="true">02</span>
          <div class="ps-card-badges">
            <span class="ps-card-badge">Research report</span>
          </div>
        </div>

        <div class="ps-journal-cover" aria-hidden="true">
          {res004Cover ? (
            <img
              src={res004Cover}
              alt=""
              class="ps-journal-cover-img"
              loading="lazy"
              decoding="async"
              width="640"
              height="360"
            />
          ) : (
            <div class="ps-journal-cover-fallback">
              <svg viewBox="0 0 640 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="ps-journal-fallback-svg" role="img" aria-label="Observatory figure fallback">
                <rect width="640" height="360" fill="#FDFCF8" stroke="#17191A" stroke-width="1" />
                <line x1="0" y1="180" x2="640" y2="180" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <line x1="320" y1="0" x2="320" y2="360" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <circle cx="320" cy="180" r="90" stroke="#17191A" stroke-width="1.2" fill="none" />
                <circle cx="320" cy="180" r="60" stroke="#827D71" stroke-width="0.8" stroke-dasharray="2 3" fill="none" />
                <circle cx="320" cy="180" r="4" fill="#D3F03C" stroke="#17191A" stroke-width="1" />
                <text x="320" y="295" font-family="'Cascadia Code', Consolas, monospace" font-size="11" font-weight="700" fill="#4A4F4C" text-anchor="middle" letter-spacing="0.12em">FIELD BRIEFING ARCHIVE</text>
              </svg>
            </div>
          )}
          <div class="ps-journal-cover-overlay"></div>
          <div class="ps-journal-cover-plate">
            <span>FIG // 02 · RES-004</span>
          </div>
          <div class="ps-journal-cover-coord">
            <span>OBS // 12.97° N</span>
          </div>
        </div>

        <div class="ps-card-content-wrap">
          <p class="ps-kicker">Research · RES-004 · July 2026</p>
          <h3>{res004Title}</h3>
          <p>{res004Summary}</p>
        </div>

        <span class="ps-card-foot">
          <span>{res004Length} · {res004Citations}</span>
          <span class="ps-foot-action" aria-hidden="true">Read report <span class="ps-action-icon">→</span></span>
        </span>
      </a>

      <a class="ps-project-card ps-card-editorial ps-card-writing ps-card-journal" href={`/writing/${blg001Slug}/`}>
        <div class="ps-card-top">
          <span class="ps-card-mark" aria-hidden="true">03</span>
          <div class="ps-card-badges">
            <span class="ps-card-badge">Strategic essay</span>
          </div>
        </div>

        <div class="ps-journal-cover" aria-hidden="true">
          {blg001Cover ? (
            <img
              src={blg001Cover}
              alt=""
              class="ps-journal-cover-img"
              loading="lazy"
              decoding="async"
              width="640"
              height="360"
            />
          ) : (
            <div class="ps-journal-cover-fallback">
              <svg viewBox="0 0 640 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="ps-journal-fallback-svg" role="img" aria-label="Observatory figure fallback">
                <rect width="640" height="360" fill="#FDFCF8" stroke="#17191A" stroke-width="1" />
                <line x1="0" y1="180" x2="640" y2="180" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <line x1="320" y1="0" x2="320" y2="360" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <circle cx="320" cy="180" r="90" stroke="#17191A" stroke-width="1.2" fill="none" />
                <circle cx="320" cy="180" r="60" stroke="#827D71" stroke-width="0.8" stroke-dasharray="2 3" fill="none" />
                <circle cx="320" cy="180" r="4" fill="#D3F03C" stroke="#17191A" stroke-width="1" />
                <text x="320" y="295" font-family="'Cascadia Code', Consolas, monospace" font-size="11" font-weight="700" fill="#4A4F4C" text-anchor="middle" letter-spacing="0.12em">FIELD BRIEFING ARCHIVE</text>
              </svg>
            </div>
          )}
          <div class="ps-journal-cover-overlay"></div>
          <div class="ps-journal-cover-plate">
            <span>FIG // 03 · BLG-001</span>
          </div>
          <div class="ps-journal-cover-coord">
            <span>OBS // 12.97° N</span>
          </div>
        </div>

        <div class="ps-card-content-wrap">
          <p class="ps-kicker">Writing · BLG-001 · July 2026</p>
          <h3>{blg1Title}</h3>
          <p>{blg1Summary}</p>
        </div>

        <span class="ps-card-foot">
          <span>{blg1Length} · Derived from RES-018</span>
          <span class="ps-foot-action" aria-hidden="true">Read article <span class="ps-action-icon">→</span></span>
        </span>
      </a>

      <a class="ps-project-card ps-card-editorial ps-card-writing ps-card-journal" href={`/writing/${blg002Slug}/`}>
        <div class="ps-card-top">
          <span class="ps-card-mark" aria-hidden="true">04</span>
          <div class="ps-card-badges">
            <span class="ps-card-badge">Strategic essay</span>
          </div>
        </div>

        <div class="ps-journal-cover" aria-hidden="true">
          {blg002Cover ? (
            <img
              src={blg002Cover}
              alt=""
              class="ps-journal-cover-img"
              loading="lazy"
              decoding="async"
              width="640"
              height="360"
            />
          ) : (
            <div class="ps-journal-cover-fallback">
              <svg viewBox="0 0 640 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="ps-journal-fallback-svg" role="img" aria-label="Observatory figure fallback">
                <rect width="640" height="360" fill="#FDFCF8" stroke="#17191A" stroke-width="1" />
                <line x1="0" y1="180" x2="640" y2="180" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <line x1="320" y1="0" x2="320" y2="360" stroke="#827D71" stroke-width="0.8" stroke-dasharray="4 4" />
                <circle cx="320" cy="180" r="90" stroke="#17191A" stroke-width="1.2" fill="none" />
                <circle cx="320" cy="180" r="60" stroke="#827D71" stroke-width="0.8" stroke-dasharray="2 3" fill="none" />
                <circle cx="320" cy="180" r="4" fill="#D3F03C" stroke="#17191A" stroke-width="1" />
                <text x="320" y="295" font-family="'Cascadia Code', Consolas, monospace" font-size="11" font-weight="700" fill="#4A4F4C" text-anchor="middle" letter-spacing="0.12em">FIELD BRIEFING ARCHIVE</text>
              </svg>
            </div>
          )}
          <div class="ps-journal-cover-overlay"></div>
          <div class="ps-journal-cover-plate">
            <span>FIG // 04 · BLG-002</span>
          </div>
          <div class="ps-journal-cover-coord">
            <span>OBS // 12.97° N</span>
          </div>
        </div>

        <div class="ps-card-content-wrap">
          <p class="ps-kicker">Writing · BLG-002 · July 2026</p>
          <h3>{blg2Title}</h3>
          <p>{blg2Summary}</p>
        </div>

        <span class="ps-card-foot">
          <span>{blg2Length} · Energy, Heat &amp; Silicon</span>
          <span class="ps-foot-action" aria-hidden="true">Read article <span class="ps-action-icon">→</span></span>
        </span>
      </a>
    </EditorialCarousel>
    <p class="ps-shelf-note">
      Independent research and analysis are presented as static, structured briefings. Full source archives and data tables are linked directly within each document.
    </p>
  </section>

  {/* 5. About — Chapter: neutral warm, editorial two-column */}
  <section class="ps-section ps-section--chapter-about" id="about" aria-labelledby="about-title">
    <div class="ps-about-editorial">
      <div>
        <p class="ps-eyebrow">About the work</p>
        <h2 id="about-title">Work worth understanding.</h2>
        <p class="ps-lede">
          This site brings together software projects, structured research briefings, and analytical writing focused on how computing systems and artificial intelligence operate under real-world constraints.
        </p>
        <p>
          Every project and report is documented with clear scope, source evidence, and practical evaluation.
        </p>
        <a class="ps-text-link" href="/about/">
          More on the About page
          <span aria-hidden="true" set:html={ArrowRight}></span>
        </a>
      </div>
      <aside class="ps-about-aside" aria-label="Quick facts">
        <p class="ps-about-aside-label">At a glance</p>
        <div class="ps-about-aside-stat">
          <span class="ps-about-aside-num">2</span>
          <span class="ps-about-aside-desc">Published projects</span>
        </div>
        <div class="ps-about-aside-stat">
          <span class="ps-about-aside-num">55</span>
          <span class="ps-about-aside-desc">Technologies &amp; skills</span>
        </div>
        <div class="ps-about-aside-stat">
          <span class="ps-about-aside-num">42+</span>
          <span class="ps-about-aside-desc">Research &amp; writing pieces</span>
        </div>
        <div class="ps-about-aside-stat">
          <span class="ps-about-aside-num">BLR</span>
          <span class="ps-about-aside-desc">12.9716° N · 77.5946° E</span>
        </div>
      </aside>
    </div>
  </section>

  {/* 6. Contact strip */}
  <section class="ps-contact" id="contact" aria-labelledby="contact-title">
    <div>
      <p class="ps-eyebrow" style="color: rgba(253,252,248,0.65);">Inquiries &amp; Exchange</p>
      <h2 id="contact-title">Have a thoughtful question or discussion?</h2>
      <p>Whether discussing frontier research, technical methodology, or potential collaboration, genuine inquiries are welcome.</p>
    </div>
    <a class="ps-button" href="/contact/">Get in touch</a>
  </section>

  <!-- Contextual Recruiter Engagement (Stage 3B) -->
  <RecruiterEngagement />
</ProductionPaperSignalLayout>
