---
import ProductionPaperSignalLayout from '../layouts/ProductionPaperSignalLayout.astro';
import { getResearchReportBySlug, getWritingArticleBySlug } from '../lib/sanityClient';
import { getArticleReadingTime } from '../lib/readingTime';

const res018Slug = 'strategic-intelligence-report-the-state-of-artificial-intelligence-and-frontier-technologies-in-2026';
const blg001Slug = 'agentic-inflection-point';
const blg002Slug = 'ai-physical-limits';

const [res018, blg001, blg002] = await Promise.all([
  getResearchReportBySlug(res018Slug),
  getWritingArticleBySlug(blg001Slug),
  getWritingArticleBySlug(blg002Slug),
]);

const resTitle = res018?.title || 'Strategic Intelligence Report: The State of Artificial Intelligence and Frontier Technologies in 2026';
const resSummary = res018?.summary || 'A comprehensive 2026 strategic briefing on AI progress, compute constraints, reasoning models, enterprise ROI, and sovereign technology developments.';
const resLength = (res018?.lengthEstimateMinutes || 15) + ' min read';
const resCitations = Array.isArray(res018?.bibliography) ? `${res018.bibliography.length} citations` : '71 citations';

const blg1Title = blg001?.title || 'The Agentic Inflection Point';
const blg1Summary = blg001?.summary || 'A strategic analysis of where autonomous AI systems actually are, the capability gaps that remain, and what the trajectory implies for organizations.';
const blg1Length = getArticleReadingTime(blg001);

const blg2Title = blg002?.title || "AI's Physical Limits";
const blg2Summary = blg002?.summary || 'Semiconductor concentration, energy constraints, and water scarcity on the AI trajectory.';
---

<ProductionPaperSignalLayout
  title="Goutam Prusty — Research, writing, and practical systems"
  description="A personal library of strategic intelligence, analytical writing, and practical experiments by Goutam Prusty."
>
  <section class="ps-hero" aria-labelledby="hero-title">
    <div class="ps-hero-copy">
      <p class="ps-eyebrow">Research · Writing · Systems</p>
      <h1 id="hero-title">Curiosity, made <em>useful.</em></h1>
      <p class="ps-lede">
        A personal library of strategic intelligence, analytical writing, and practical experiments. Exploring how complex technologies work, where their limits lie, and how ideas become dependable systems.
      </p>
      <div class="ps-actions">
        <a class="ps-button" href="#selected-work">Explore selected work <span aria-hidden="true">↓</span></a>
        <a class="ps-text-link" href="/about/">About Goutam <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="ps-art" role="img" aria-label="Abstract geometric composition in peach, lime and blue representing inquiry and systems">
      <div class="art-arch"></div>
      <div class="art-circle"></div>
      <div class="art-half"></div>
      <div class="art-ring"></div>
      <span class="ps-art-label" aria-hidden="true">PAPER / SIGNAL</span>
    </div>
  </section>

  <section class="ps-section" id="selected-work" aria-labelledby="selected-title">
    <div class="ps-section-head">
      <div>
        <p class="ps-eyebrow">Curated briefings &amp; analysis</p>
        <h2 id="selected-title">Selected work</h2>
      </div>
      <a class="ps-text-link" href="/research/">Explore all research ↗</a>
    </div>
    <div class="ps-project-grid">
      <a class="ps-project-card ps-card-editorial ps-card-research" href={`/research/${res018Slug}/`}>
        <div class="ps-card-top">
          <span class="ps-card-mark" aria-hidden="true">01</span>
          <span class="ps-card-badge">Research report</span>
        </div>
        <p class="ps-kicker">Research · RES-018 · July 2026</p>
        <h3>{resTitle}</h3>
        <p>{resSummary}</p>
        <span class="ps-card-foot">
          <span>{resLength} · {resCitations}</span>
          <span aria-hidden="true">Read report ↗</span>
        </span>
      </a>

      <a class="ps-project-card ps-card-editorial ps-card-writing" href={`/writing/${blg001Slug}/`}>
        <div class="ps-card-top">
          <span class="ps-card-mark" aria-hidden="true">02</span>
          <span class="ps-card-badge">Strategic essay</span>
        </div>
        <p class="ps-kicker">Writing · BLG-001 · July 2026</p>
        <h3>{blg1Title}</h3>
        <p>{blg1Summary}</p>
        <span class="ps-card-foot">
          <span>{blg1Length} · Derived from RES-018</span>
          <span aria-hidden="true">Read article ↗</span>
        </span>
      </a>
    </div>
    <p class="ps-shelf-note">
      Independent research and analysis are presented as static, structured briefings. Full source archives and data tables are linked directly within each document.
    </p>
  </section>

  <section class="ps-section ps-discovery" id="analysis" aria-label="Research, writing and topics">
    <div>
      <p class="ps-eyebrow">Keep following a thread</p>
      <h2>Connected analysis</h2>
      <p class="ps-muted">
        Long-form research briefings connect directly into focused essays examining specific bottlenecks, capabilities, and real-world implications.
      </p>
      <a class="ps-text-link" href="/writing/">Browse all writing ↗</a>
    </div>
    <div>
      <p class="ps-eyebrow">Recent briefings &amp; articles</p>
      <ul class="ps-link-list">
        <li>
          <a href={`/writing/${blg002Slug}/`}>
            <span class="ps-link-item-text">
              <strong class="ps-link-title">{blg2Title}</strong>
              <span class="ps-link-desc">{blg2Summary}</span>
            </span>
            <span class="ps-arrow-link" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={`/writing/${blg001Slug}/`}>
            <span class="ps-link-item-text">
              <strong class="ps-link-title">{blg1Title}</strong>
              <span class="ps-link-desc">{blg1Summary}</span>
            </span>
            <span class="ps-arrow-link" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
      <div class="ps-topic-row" aria-label="Research topics">
        <span class="ps-topic">Artificial Intelligence</span>
        <span class="ps-topic">Frontier Infrastructure</span>
        <span class="ps-topic">Autonomous Systems</span>
        <span class="ps-topic">Semiconductors &amp; Energy</span>
        <a class="ps-topic" href="/topics/">All topics →</a>
      </div>
    </div>
  </section>

  <section class="ps-section" id="about" aria-labelledby="about-title">
    <p class="ps-eyebrow">A note about this place</p>
    <h2 id="about-title">Work worth understanding.</h2>
    <p class="ps-lede">
      This site serves as an open personal library for long-form research, strategic analysis, and systems inquiry. Every document is anchored in primary source evidence, clear methodologies, and transparent citations.
    </p>
    <p>
      Rather than chasing brief commentary or ephemeral news, the focus here is on questions with lasting consequences: how artificial intelligence reshapes computing and institutions, where physical constraints bind digital ambitions, and how complex ideas become dependable systems.
    </p>
    <a class="ps-text-link" href="/about/">Read more about the library and ethos ↗</a>
  </section>

  <section class="ps-contact" id="contact" aria-labelledby="contact-title">
    <div>
      <p class="ps-eyebrow">Inquiries &amp; Exchange</p>
      <h2 id="contact-title">Have a thoughtful question or discussion?</h2>
      <p>Whether discussing frontier research, technical methodology, or potential collaboration, genuine inquiries are welcome.</p>
    </div>
    <a class="ps-button" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a>
  </section>
</ProductionPaperSignalLayout>
