---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContentList from '../components/ContentList.astro';
import ActionLink from '../components/ActionLink.astro';
import VisualFigure from '../components/VisualFigure.astro';
import { works, topics, topicSlug, fixtureNotice } from '../data/fixtures';
---
<SiteLayout title="Home | goutamprusty.com"><div class="home-hero"><PageIntro eyebrow="Development template" title="Explore. Understand. Build. Explain." summary="A development-only homepage composition preview. Replace this introductory copy with approved, verified content." /><VisualFigure label="Homepage visual companion" caption="Optional image area for verified work or portrait material." /></div><section class="selected-work"><div class="section-heading"><p class="eyebrow">A sample library</p><h2>Selected work</h2></div><p class="fixture-note">{fixtureNotice}</p><ContentList entries={works} /></section><section class="topics-section"><div><p class="eyebrow">Browse by subject</p><h2>Explore topics</h2></div><ul class="topic-list">{topics.map((topic) => <li><a href={`/topics/${topicSlug(topic)}/`}>{topic}<span aria-hidden="true">↗</span></a></li>)}</ul></section><section class="library-section"><h2>Browse the library</h2><p>Development-only route preview.</p><ActionLink href="/research/">Explore research</ActionLink></section></SiteLayout>
<style>.home-hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(15rem,.85fr);align-items:center;gap:clamp(2rem,6vw,5rem);padding-bottom:clamp(2rem,5vw,4rem)}.home-hero :global(.page-intro){padding-block:clamp(3.5rem,8vw,6.5rem)}section{padding-block:clamp(2rem,5vw,4rem);border-top:1px solid var(--color-line)}.fixture-note{color:var(--color-muted);font-size:.9rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.eyebrow{margin-bottom:.65rem;color:var(--color-accent);font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.topics-section{display:grid;grid-template-columns:minmax(12rem,.65fr) minmax(0,1.35fr);gap:clamp(2rem,6vw,5rem);background:var(--color-accent-soft);padding-inline:clamp(1.25rem,4vw,3rem)}.topics-section h2{margin-bottom:0}.topic-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin:0;padding:0;list-style:none}.topic-list li a{display:flex;min-height:5rem;align-items:center;justify-content:space-between;gap:1rem;padding:1rem;border-bottom:1px solid var(--color-line);color:var(--color-ink);text-decoration:none}.topic-list li a:hover{color:var(--color-accent);border-color:var(--color-accent)}.library-section{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}.library-section h2,.library-section p{margin:0}.library-section p{color:var(--color-muted)}@media(max-width:48rem){.home-hero{grid-template-columns:1fr;gap:0}.home-hero :global(.page-intro){padding-bottom:2rem}.topics-section{grid-template-columns:1fr}.topic-list{grid-template-columns:1fr}.section-heading{display:block}}</style>
