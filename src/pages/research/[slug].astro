---
import ProductionPaperSignalLayout from '../../layouts/ProductionPaperSignalLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { normalizeAssetPath } from '../../lib/pathNormalizer';
import { getImageDimensions } from '../../lib/imageDimensions';
import { getAllResearchSlugs, getResearchReportBySlug } from '../../lib/sanityClient';

export async function getStaticPaths() {
  const slugs = await getAllResearchSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const report = await getResearchReportBySlug(slug as string);

const title = report ? report.title : 'Research Report';
const summary = report ? report.summary : '';
const category = report ? report.category : 'Research';
const publishedAt = report?.publishedAt ? new Date(report.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const readingTime = (report?.lengthEstimateMinutes || report?.readingTimeMinutes) ? `${report.lengthEstimateMinutes || report.readingTimeMinutes} min read` : '';
const bodyBlocks = report?.body || [];
const bibliography = report?.bibliography || [];
const rawDerivedPosts = report?.derivedPosts || [];
const derivedPosts = Array.isArray(rawDerivedPosts)
  ? rawDerivedPosts.filter((post: any) => Boolean(post && (post.slug?.current || (typeof post.slug === 'string' && post.slug.trim().length > 0))))
  : [];
const coverImage = report?.coverImage;
const coverSrc = coverImage?.assetPath ? normalizeAssetPath(coverImage.assetPath) : null;
const coverDims = coverSrc ? getImageDimensions(coverSrc) : null;
const ogImage = coverSrc;
const researchJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  author: {
    '@type': 'Person',
    name: 'Goutam Prusty',
    url: 'https://goutamprusty.com/',
  },
  mainEntityOfPage: `https://goutamprusty.com/research/${slug}/`,
};
if (ogImage) {
  researchJsonLd.image = new URL(ogImage, 'https://goutamprusty.com').toString();
}
if (report?.publishedAt) {
  researchJsonLd.datePublished = String(report.publishedAt).split('T')[0];
}
---

<ProductionPaperSignalLayout
  title={`${title} — goutamprusty.com`}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  jsonLd={researchJsonLd}
>
  <div class="ps-page-head ps-article-head">
    <p class="ps-eyebrow">Research · {category}</p>
    <h1 class="text-3xl md:text-5xl font-serif font-bold text-stone-900 tracking-tight leading-tight mt-2 mb-4">{title}</h1>
    <p class="ps-lede text-lg md:text-xl text-stone-700 leading-relaxed font-serif max-w-3xl mb-6">{summary}</p>
    <div class="ps-meta flex flex-wrap gap-4 text-xs font-mono text-stone-500 border-t border-stone-200 pt-3">
      <span><strong>Published</strong> {publishedAt}</span>
      <span><strong>Reading time</strong> {readingTime}</span>
      <span><strong>ID</strong> {report?.workbookId || 'SAMPLE'}</span>
    </div>
  </div>

  <div class="ps-body-grid max-w-4xl mx-auto my-8">
    <article class="ps-article">
      {coverSrc && (
        <div class="my-8 rounded overflow-hidden border border-stone-200">
          <img
            src={coverSrc}
            alt={coverImage.alt || title}
            width={coverDims?.width}
            height={coverDims?.height}
            class="w-full h-auto"
            loading="eager"
          />
          {coverImage.caption && <p class="text-xs text-stone-500 p-2 italic">{coverImage.caption}</p>}
        </div>
      )}

      {bodyBlocks.length > 0 && (
        <PortableText blocks={bodyBlocks} />
      )}

      {derivedPosts.length > 0 && (
        <section id="derived-articles" class="mt-12 pt-8 border-t border-stone-200">
          <p class="text-xs font-mono text-stone-500 uppercase tracking-widest mb-2">Derived Writing</p>
          <h2 class="text-2xl font-serif font-bold text-stone-900 mb-4">Articles Derived from this Research</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {derivedPosts.map((post: any) => {
              const postSlug = post?.slug?.current || (typeof post?.slug === 'string' ? post.slug.trim() : '');
              if (!postSlug) return null;
              return (
                <a href={`/writing/${postSlug}/`} class="block p-4 bg-stone-50 hover:bg-stone-100 border border-stone-200 rounded transition-colors">
                  <h3 class="font-serif font-semibold text-stone-900 mb-1">{post?.title || postSlug}</h3>
                  {post?.summary && <p class="text-xs text-stone-600 line-clamp-2">{post.summary}</p>}
                </a>
              );
            })}
          </div>
        </section>
      )}

      {bibliography.length > 0 && (
        <section id="references" class="mt-12 pt-8 border-t border-stone-200">
          <p class="text-xs font-mono text-stone-500 uppercase tracking-widest mb-2">Sources & Methodology</p>
          <h2 class="text-2xl font-serif font-bold text-stone-900 mb-6">Works Cited ({bibliography.length})</h2>
          <ol class="space-y-3 text-sm text-stone-700">
            {bibliography.map((entry: any, idx: number) => {
              const num = entry.order || entry.number || (idx + 1);
              return (
                <li id={`cite-${num}`} class="flex gap-3 leading-relaxed">
                  <span class="text-stone-400 font-mono text-xs pt-0.5 select-none">[{num}]</span>
                  <div>
                    {entry.url ? (
                      <a href={entry.url} target="_blank" rel="noopener noreferrer" class="font-medium text-stone-900 hover:underline underline-offset-2 break-all">
                        {entry.title || entry.rawText}
                      </a>
                    ) : (
                      <span class="font-medium text-stone-900">{entry.title || entry.rawText}</span>
                    )}
                    {entry.publication && <span class="text-stone-500"> — {entry.publication}</span>}
                    {entry.date && <span class="text-stone-400"> ({entry.date})</span>}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      )}
    </article>
  </div>
</ProductionPaperSignalLayout>
