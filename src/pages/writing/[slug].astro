---
import ProductionPaperSignalLayout from '../../layouts/ProductionPaperSignalLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { getAllWritingSlugs, getWritingArticleBySlug } from '../../lib/sanityClient';
import { getArticleReadingTime } from '../../lib/readingTime';
import { normalizeAssetPath } from '../../lib/pathNormalizer';
import { getImageDimensions } from '../../lib/imageDimensions';

export async function getStaticPaths() {
  const slugs = await getAllWritingSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = await getWritingArticleBySlug(slug as string);

const title = article ? article.title : 'Article';
const summary = article ? article.summary : '';
const category = article ? article.category : 'Writing';
const publishedAt = article?.publishedAt ? new Date(article.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const readingTime = getArticleReadingTime(article);
const bodyBlocks = article?.body || [];
const sourceReport = article?.sourceReport;
const sourceReportSlug = sourceReport?.slug?.current || (typeof sourceReport?.slug === 'string' ? sourceReport.slug.trim() : null);
const coverImage = article?.coverImage;
const coverSrc = coverImage?.assetPath ? normalizeAssetPath(coverImage.assetPath) : null;
const coverDims = coverSrc ? getImageDimensions(coverSrc) : null;
const ogImage = coverSrc;
const writingJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  author: {
    '@type': 'Person',
    name: 'Goutam Prusty',
    url: 'https://goutamprusty.com/',
  },
  mainEntityOfPage: `https://goutamprusty.com/writing/${slug}/`,
};
if (article?.publishedAt) {
  writingJsonLd.datePublished = String(article.publishedAt).split('T')[0];
}
---

<ProductionPaperSignalLayout
  title={`${title} — goutamprusty.com`}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  jsonLd={writingJsonLd}
>
  <header class="ps-page-head ps-article-head">
    <p class="ps-eyebrow">Writing · {category}</p>
    <h1 class="text-3xl md:text-5xl font-serif font-bold text-stone-900 tracking-tight leading-tight mt-2 mb-4">{title}</h1>
    <p class="ps-lede text-lg md:text-xl text-stone-700 leading-relaxed font-serif max-w-3xl mb-6">{summary}</p>
    <div class="ps-meta flex flex-wrap gap-4 text-xs font-mono text-stone-500 border-t border-stone-200 pt-3">
      <span><strong>Published</strong> {publishedAt}</span>
      <span><strong>Reading time</strong> {readingTime}</span>
      <span><strong>ID</strong> {article?.workbookId || 'SAMPLE'}</span>
    </div>
  </header>

  <div class="ps-body-grid max-w-4xl mx-auto my-8">
    <article class="ps-article">
      {coverSrc && (
        <div class="my-8 rounded overflow-hidden border border-stone-200">
          <img
            src={coverSrc}
            alt={coverImage.alt || title}
            width={coverDims?.width}
            height={coverDims?.height}
            class="w-full h-auto"
            loading="eager"
          />
          {coverImage.caption && <p class="text-xs text-stone-500 p-2 italic">{coverImage.caption}</p>}
        </div>
      )}

      {sourceReport && sourceReportSlug && (
        <div class="my-6 p-4 bg-stone-50 border-l-4 border-lime-400 rounded-r text-sm">
          <p class="text-xs font-mono text-stone-500 uppercase tracking-widest mb-1">Parent Research Report</p>
          <p class="text-stone-800">
            This article is an editorial companion to:
            <a href={`/research/${sourceReportSlug}/`} class="font-serif font-medium text-stone-900 underline underline-offset-2 ml-1 hover:text-stone-700">
              {sourceReport.title || 'Research Report'} &rarr;
            </a>
          </p>
        </div>
      )}

      {bodyBlocks.length > 0 && (
        <PortableText blocks={bodyBlocks} />
      )}
    </article>
  </div>
</ProductionPaperSignalLayout>
