---
import ProductionPaperSignalLayout from '../../layouts/ProductionPaperSignalLayout.astro';
import { collections, fixtureNotice } from '../../data/fixtures';

export function getStaticPaths() {
  return collections.map((item) => ({
    params: { slug: 'sample-series' },
    props: { item },
  }));
}

const { item } = Astro.props;
const title = item.title;
const summary = item.summary;
const type = 'Collection';
const sections = [
  {
    id: 'sequence',
    title: 'Suggested sequence',
    body: 'Placeholder collection sequence.',
  },
];
---

<ProductionPaperSignalLayout
  title={`${title} — goutamprusty.com`}
  description={summary}
>
  <header class="ps-page-head">
    <p class="ps-eyebrow">{type} · Curated series · Development template</p>
    <h1>{title}</h1>
    <p class="ps-lede">{summary}</p>
    <div class="ps-meta">
      <span><strong>Type</strong> {type}</span>
      <span><strong>Status</strong> {fixtureNotice}</span>
    </div>
  </header>

  <div class="ps-body-grid" style="padding-top: 2rem;">
    <article class="ps-article">
      <div class="ps-note" style="margin-bottom: 2rem;">
        {fixtureNotice}
      </div>
      {sections.map((section) => (
        <section id={section.id}>
          <p class="ps-eyebrow">Section</p>
          <h2>{section.title}</h2>
          <p class="ps-placeholder">{section.body}</p>
        </section>
      ))}
      <section id="browse" style="margin-top: 1.5rem;">
        <p class="ps-eyebrow">Navigation</p>
        <p>
          <a href="/collections/" class="ps-text-link">← Return to all collections</a>
        </p>
      </section>
    </article>
    <aside class="ps-aside" aria-label="Collection sections">
      <h2>On this page</h2>
      <ol>
        {sections.map((section) => (
          <li><a href={`#${section.id}`}>{section.title}</a></li>
        ))}
      </ol>
    </aside>
  </div>
</ProductionPaperSignalLayout>
