---
import ProductionPaperSignalLayout from '../../layouts/ProductionPaperSignalLayout.astro';
import { collections, fixtureNotice } from '../../data/fixtures';

const title = 'Collections / Series';
const summary = 'Curated paths through related work.';
---

<ProductionPaperSignalLayout
  title={`${title} — goutamprusty.com`}
  description={summary}
>
  <header class="ps-page-head">
    <p class="ps-eyebrow">Curated pathways · Development template</p>
    <h1>{title}</h1>
    <p class="ps-lede">{summary}</p>
  </header>

  <section class="ps-section" aria-label="Collections and series">
    <p class="ps-shelf-note" style="margin-top: 0 !important; margin-bottom: 2rem;">
      {fixtureNotice}
    </p>
    <div class:list={['ps-project-grid', { 'ps-project-grid--single': collections.length === 1 }]}>
      {collections.map((item, idx) => (
        <a
          class="ps-project-card ps-card-editorial"
          href={item.href}
        >
          <div class="ps-card-top">
            <span class="ps-card-mark" aria-hidden="true">
              {String(idx + 1).padStart(2, '0')}
            </span>
            <span class="ps-card-badge">Collection</span>
          </div>
          <p class="ps-kicker">Series · Pathway</p>
          <h3>{item.title}</h3>
          {item.summary && <p>{item.summary}</p>}
          <span class="ps-card-foot">
            <span>Development fixture</span>
            <span aria-hidden="true">Explore collection ↗</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</ProductionPaperSignalLayout>
