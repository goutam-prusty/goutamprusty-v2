---
import ProductionPaperSignalLayout from '../layouts/ProductionPaperSignalLayout.astro';

const title = 'About';
const summary = 'Background, library ethos, and analytical approach.';
const sections = [
  {
    id: 'ethos',
    title: 'Library ethos',
    body: 'This site serves as an open personal library for long-form research, strategic analysis, and systems inquiry. Every document is anchored in primary source evidence, clear methodologies, and transparent citations.',
  },
  {
    id: 'approach',
    title: 'Analytical approach',
    body: 'Rather than chasing brief commentary or ephemeral news, the focus here is on questions with lasting consequences: how artificial intelligence reshapes computing and institutions, where physical constraints bind digital ambitions, and how complex ideas become dependable systems.',
  },
];
---

<ProductionPaperSignalLayout
  title="About — goutamprusty.com"
  description={summary}
>
  <header class="ps-page-head">
    <p class="ps-eyebrow">Information · Library Ethos</p>
    <h1>{title}</h1>
    <p class="ps-lede">{summary}</p>
  </header>

  <div class="ps-body-grid" style="padding-top: 2rem;">
    <article class="ps-article">
      {sections.map((section) => (
        <section id={section.id}>
          <p class="ps-eyebrow">Section</p>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </section>
      ))}
    </article>
    <aside class="ps-aside" aria-label="About page sections">
      <h2>On this page</h2>
      <ol>
        {sections.map((section) => (
          <li><a href={`#${section.id}`}>{section.title}</a></li>
        ))}
      </ol>
    </aside>
  </div>
</ProductionPaperSignalLayout>
