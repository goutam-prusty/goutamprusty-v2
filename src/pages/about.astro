---
import ProductionPaperSignalLayout from '../layouts/ProductionPaperSignalLayout.astro';
import { fixtureNotice } from '../data/fixtures';

const title = 'About';
const summary = 'A page template for verified background and approach.';
const type = 'Page';
const sections = [
  {
    id: 'overview',
    title: 'Overview',
    body: 'Development placeholder. Replace with author-approved, verified copy.',
  },
  {
    id: 'approach',
    title: 'Approach',
    body: 'Development placeholder. No personal claims are supplied in this fixture.',
  },
];
---

<ProductionPaperSignalLayout
  title="About — goutamprusty.com"
  description={summary}
>
  <header class="ps-page-head">
    <p class="ps-eyebrow">{type} · Development template</p>
    <h1>{title}</h1>
    <p class="ps-lede">{summary}</p>
    <div class="ps-meta">
      <span><strong>Type</strong> {type}</span>
      <span><strong>Status</strong> {fixtureNotice}</span>
    </div>
  </header>

  <div class="ps-body-grid" style="padding-top: 2rem;">
    <article class="ps-article">
      <div class="ps-note" style="margin-bottom: 2rem;">
        {fixtureNotice}
      </div>
      {sections.map((section) => (
        <section id={section.id}>
          <p class="ps-eyebrow">Section</p>
          <h2>{section.title}</h2>
          <p class="ps-placeholder">{section.body}</p>
        </section>
      ))}
    </article>
    <aside class="ps-aside" aria-label="About page sections">
      <h2>On this page</h2>
      <ol>
        {sections.map((section) => (
          <li><a href={`#${section.id}`}>{section.title}</a></li>
        ))}
      </ol>
    </aside>
  </div>
</ProductionPaperSignalLayout>
