# Sanity CMS Configuration
PUBLIC_SANITY_PROJECT_ID=l94q5yx8
PUBLIC_SANITY_DATASET=development

# Server-Only Read Authentication Token (Required for Cloudflare Pages / CI with private dataset)
# Never prefix with PUBLIC_. Never commit real secrets.
# In Sanity Manage (https://sanity.io/manage): Project -> API -> Tokens -> Add API token -> Role: Viewer
SANITY_API_READ_TOKEN=your_sanity_read_token_here

# Optional: Strict Live Build Enforcement (Set to 'true' to prevent fallback to local fixtures)
# SANITY_REQUIRE_LIVE=true
