    "blockerCount": 2,
    "warningCount": 5,
    "passCount": 61,
    "verdict": "CONDITIONAL_APPROVAL — Architecture is sound and lossless; Ingestion tooling must resolve reference pointers and inject array item _type keys prior to Content Lake import."
  },
  "criticalFindings": [
    {
      "id": "F-01",
      "category": "Sanity Studio Compatibility",
      "classification": "BLOCKER",
      "schemaFile": "migration/schema/objects/tableBlock.ts, bibliographyEntry.ts, sourceMaterialEntry.ts",
      "affectedFields": [
        "research.sourceMaterial[]",
        "research.bibliography[]",
        "tableBlock.rows[]",
        "tableRow.cells[]"
      ],
      "issue": "Missing _type on homogeneous array members in parser output",
      "detail": "Parser emits plain objects with _key but omits _type on sourceMaterial ({ _key, title, url }), bibliography ({ _key, order, rawText, title, url }), tableRow ({ _key, isHeader, cells }), and tableCell ({ _key, plainText, content }). Sanity Studio v3 requires _type on EVERY object in an array to resolve schema types and render form builders. Without _type, Sanity Studio emits 'missing _type' errors.",
      "remediation": "Ingestion pre-processor or parser must inject _type: 'sourceMaterialEntry', _type: 'bibliographyEntry', _type: 'tableRow', and _type: 'tableCell' prior to mutation."
    },
    {
      "id": "F-02",
      "category": "Reference Contract",
      "classification": "BLOCKER",
      "schemaFile": "migration/schema/documents/research.ts, writing.ts",
      "affectedFields": [
        "research.derivedPosts",
        "writing.sourceReport"
      ],
      "issue": "Parser emits raw string slugs instead of Sanity reference objects",
      "detail": "Schema defines these fields as type: 'reference'. Parser emits raw slug strings (e.g. 'structure-not-conspiracy' in RES-015, 'strategic-intelligence-report-...' in BLG-001). Sanity Content Lake rejects raw strings for reference fields with ValidationError: Expected object of type reference.",
      "remediation": "Ingestion tooling must implement two-phase reference resolution: map source slugs to authoritative Sanity document IDs (research-RES-xxx, writing-BLG-xxx) and emit { _type: 'reference', _ref: '<docId>' }."
    },
    {
      "id": "F-03",
      "category": "Object Typing",
      "classification": "WARNING",
      "schemaFile": "migration/schema/documents/research.ts, writing.ts, project.ts",
      "affectedFields": [
        "research.coverImage",
        "writing.coverImage",
        "project.coverImage"
      ],
      "issue": "Type mismatch: Parser emits _type: 'image' while schema defines anonymous type: 'object'",
      "detail": "Parser sets _type: 'image' on coverImage objects with assetPath. In Sanity Studio, type: 'image' is reserved for native image asset records with asset: { _ref }. Schema defines coverImage as an anonymous object with assetPath and alt fields.",
      "remediation": "Align schema and parser: define a named coverImage object schema or normalize to asset: { _type: 'reference', _ref: ... } during live asset upload."
    },
    {
      "id": "F-04",
      "category": "Object Typing",
      "classification": "WARNING",
      "schemaFile": "migration/schema/objects/seo.ts, sourceArchive.ts",
      "affectedFields": [
        "writing.seo",
        "research.sourceArchive",
        "writing.sourceArchive",
        "project.sourceArchive"
      ],
      "issue": "Top-level named object values lack explicit _type property",
      "detail": "Parser emits seo as { metaTitle, metaDescription } and sourceArchive as { v1GitCommit, ... } without _type: 'seo' or _type: 'sourceArchive'. Sanity Content Lake expects named object fields to carry _type matching their schema name.",
      "remediation": "Ingestion tooling should attach _type: 'seo' and _type: 'sourceArchive' to preserve schema alignment in Studio."
    },
    {
      "id": "F-05",
      "category": "Test Validation Scope",
      "classification": "WARNING",
      "schemaFile": "migration/lib/schema-validator.cjs",
      "affectedFields": [
        "schema-validator.cjs"
      ],
      "issue": "Validator checks structural AST shape but does not verify disk asset presence or reference resolution",
      "detail": "Custom validator passes HOLD documents (e.g. BLG-012) because their AST syntax is structurally valid, even though image paths are route-relative on disk. Validator also accepts string slugs for reference fields and infers missing _type on homogeneous array items.",
      "remediation": "Document that schema validation proves AST structural conformance, NOT migration eligibility. Ingestion tooling must enforce an independent gate requiring compatibilityStatus === 'PASS' from full-corpus-compatibility.json."
    },
    {
      "id": "F-06",
      "category": "Editorial Metadata",
      "classification": "WARNING",
      "schemaFile": "migration/schema/documents/project.ts",
      "affectedFields": [
        "project.featured"
      ],
      "issue": "V1 Project source frontmatter contains featured: true while migration policy mandates default false",
      "detail": "Inkline (PRJ-001) and Vitaliq (PRJ-002) have featured: true in V1 MDX. Schema defines initialValue: false. Ingestion tooling must decide whether to preserve V1 author frontmatter or enforce editorial rule defaulting featured to false until reviewed.",
      "remediation": "Flag for human editorial review: confirm whether V1 projects retain featured: true or import as featured: false."
    },
    {
      "id": "F-07",
      "category": "Taxonomy Alignment",
      "classification": "WARNING",
      "schemaFile": "migration/schema/documents/research.ts",
      "affectedFields": [
        "research.category",
        "research.topics",
        "writing.topics",
        "project.topics"
      ],
      "issue": "Free-text categories in V1 frontmatter vs structured taxonomy in categories.yml and workbook",
      "detail": "Research frontmatter contains strings like 'Macroeconomics & Trade', whereas categories.yml uses slugs (business-strategy). Topic associations exist only in Content_Inventory.xlsx, not in MDX frontmatter.",
      "remediation": "Ingestion tooling must import topics from Content_Inventory.xlsx and maintain category strings losslessly until an editorial decision is approved."
    }
  ],
