  "auditResolutions": {
    "F-01": {
      "finding": "Missing _type in Array Object Members",
      "severity": "BLOCKER",
      "status": "RESOLVED",
      "resolution": "Explicit _type injected into all serialized array members (sourceMaterialEntry, bibliographyEntry, tableRow, tableCell) alongside deterministic, unique _key values."
    },
    "F-02": {
      "finding": "Unresolved Reference Fields Emitted as Raw Slugs",
      "severity": "BLOCKER",
      "status": "RESOLVED",
      "resolution": "Deterministic slug-to-document-ID reference normalization engine converting string slugs to Sanity reference objects {_type: 'reference', _ref, _sourceSlug}, failing closed on unresolved or ambiguous slugs."
    },
    "F-03": {
      "finding": "Validation Blindspot for Disk Asset Existence",
      "severity": "WARNING",
      "status": "RESOLVED",
      "resolution": "Mandatory migration eligibility gate operating independently of schema validator, reading full-corpus-compatibility.json and strictly failing closed on HOLD, missing, or malformed statuses."
    },
    "F-04": {
      "finding": "Cover Image Type Discrepancy",
      "severity": "WARNING",
      "status": "RESOLVED",
      "resolution": "Standardized coverImage as an anonymous object { assetPath, alt } preserving local WebP paths without misleading _type: 'image' or fabricated Sanity asset IDs."
    },
    "F-05": {
      "finding": "Implicit Reference Integrity Dependency",
      "severity": "WARNING",
      "status": "RESOLVED",
      "resolution": "Authoritative 45-entry slug-to-ID lookup table validated with zero collisions; missing reference lookups trigger ReferenceResolutionError."
    },
    "F-06": {
      "finding": "Project Frontmatter 'featured: true' Overrides Initial Value",
      "severity": "WARNING",
      "status": "RESOLVED",
      "resolution": "V1 frontmatter value preserved as readOnly 'legacyFeatured: true' on project documents, while editorial 'featured' is strictly set to false by default."
    },
    "F-07": {
      "finding": "Taxonomy & Author Reference Contracts",
      "severity": "INFO",
      "status": "DOCUMENTED",
      "resolution": "Formal mapping specifications defined for content/_meta/authors.yml and Content_Inventory.xlsx topic sheets; ingestion decoupled to a future milestone."
    }
  },
